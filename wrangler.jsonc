{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cms-db",
      "database_id": "db7ae698-3313-4169-bba5-705ac2929426"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CMS_KV",
      "id": "ab0f91cfe73f4aa3b893de5cbefe0c45"
    }
  ]
}

# Local development only. Never commit real secrets.
DEV_ADMIN_BYPASS=true

# Required for publishing static content and media back to GitHub.
CMS_GITHUB_TOKEN=github_fine_grained_token_here
CMS_GITHUB_REPO=vineetkpe/cms
CMS_GITHUB_BRANCH=main

# CMS authentication and database are handled by Supabase Auth + RLS.
# The Supabase URL and publishable key are intentionally public client values.
# Never put a Supabase secret/service_role key in browser code.

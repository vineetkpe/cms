# Local development only. Never commit real production secrets.
# Keep this false unless you intentionally want to bypass auth locally.
DEV_ADMIN_BYPASS=false

# Optional: enables Gemini where supported. Workers AI remains the fallback.
# GEMINI_API_KEY=replace_with_your_key

# Runtime CMS storage uses the DB and CMS_KV bindings from wrangler.jsonc.
# No GitHub write token or draft encryption secret is required.

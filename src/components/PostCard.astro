---
import { slugify } from '../lib/posts';
const { post, featured = false } = Astro.props;
const href = `/${post.id.replace(/\.md$/, '')}/`;
const categoryHref = `/category/${slugify(post.data.category)}/`;
const authorHref = `/author/${slugify(post.data.author)}/`;
---
<article class:list={['post-card', { featured }] }>
  {post.data.featuredImage && (
    <a href={href} class="post-image-wrap" tabindex="-1" aria-hidden="true">
      <img class="post-image" src={post.data.featuredImage} alt={post.data.featuredImageAlt || post.data.title} width="720" height="405" loading={featured ? 'eager' : 'lazy'} decoding="async" />
    </a>
  )}
  <div class="post-card-body">
    <a class="eyebrow" href={categoryHref}>{post.data.category}</a>
    <h2><a href={href}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-meta"><a href={authorHref}>{post.data.author}</a> · {post.data.pubDate.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}</div>
  </div>
</article>

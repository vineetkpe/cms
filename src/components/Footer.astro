---
import site from '../data/site.json';
const year = new Date().getFullYear();
const socials = Object.entries(site.social || {}).filter(([, href]) => Boolean(href));
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand footer-brand" href="/">{site.logoText || site.name}</a>
      <p>{site.footerText || site.description}</p>
      {socials.length > 0 && <div class="social-links">{socials.map(([name, href]) => <a href={href} rel="me noopener" target="_blank">{name === 'x' ? 'X' : name[0].toUpperCase() + name.slice(1)}</a>)}</div>}
    </div>
    <div>
      <strong>Publication</strong>
      <a href="/about/">About</a>
      <a href="/categories/">Categories</a>
      <a href="/tags/">Tags</a>
      <a href="/editorial-policy/">Editorial policy</a>
      <a href="/contact/">Contact</a>
    </div>
    <div>
      <strong>Legal</strong>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/disclaimer/">Disclaimer</a>
    </div>
  </div>
  <div class="container footer-bottom">© {year} {site.name}. All rights reserved.</div>
</footer>

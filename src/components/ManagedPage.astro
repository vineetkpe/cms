---
import BaseLayout from '../layouts/BaseLayout.astro';
const { page } = Astro.props;
const blocks = String(page.body || '').split(/\n\s*\n/).map((value) => value.trim()).filter(Boolean).map((value) => {
  if (value.startsWith('## ')) return { type: 'h2', text: value.slice(3).trim() };
  const lines = value.split('\n').map((line) => line.trim()).filter(Boolean);
  if (lines.length && lines.every((line) => line.startsWith('- '))) return { type: 'list', items: lines.map((line) => line.slice(2).trim()) };
  return { type: 'p', text: value };
});
const trustLinks=[
  ['About','/about/'],['Editorial Policy','/editorial-policy/'],['Corrections Policy','/corrections-policy/'],['Advertising & Disclosure','/advertising-policy/'],['Privacy','/privacy/'],['Terms','/terms/'],['Disclaimer','/disclaimer/'],['Contact','/contact/']
];
---
<BaseLayout
  title={page.seoTitle || page.title}
  description={page.seoDescription || page.description}
  canonical={page.canonical || undefined}
  image={page.ogImage || undefined}
  imageAlt={page.ogImageAlt || page.title}
  socialTitle={page.socialTitle || undefined}
  socialDescription={page.socialDescription || undefined}
  noindex={Boolean(page.noindex)}
>
  <section class="managed-hero"><div class="container"><div class="kicker">{page.kicker}</div><h1>{page.title}</h1><p>{page.description}</p></div></section>
  <section class="managed-section"><div class="container managed-layout"><nav class="trust-nav" aria-label="Publication information"><strong>Publication information</strong>{trustLinks.map(([label,href])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav><article class="managed-copy">{blocks.map((block)=>block.type==='h2'?<h2>{block.text}</h2>:block.type==='list'?<ul>{block.items?.map((item)=><li>{item}</li>)}</ul>:<p>{block.text}</p>)}<slot /></article></div></section>
</BaseLayout>

---
import site from '../data/site.json';

const currentPath = Astro.url.pathname;
const navItems = [
  ...site.navigation,
  { label: 'Articles', href: '/articles/' }
].filter((item, index, items) => items.findIndex((candidate) => candidate.href === item.href) === index);

const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-mark" aria-hidden="true">{(site.logoText || site.name).slice(0, 1).toUpperCase()}</span>
      <span class="brand-name">{site.logoText || site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="header-search" href="/search/">Search</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation menu">
        <span aria-hidden="true">Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
    <div class="container mobile-nav-inner">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="/search/">Search</a>
    </div>
  </nav>
</header>
<script is:inline>
  const button = document.querySelector('.menu-button');
  const nav = document.querySelector('#mobile-nav');

  const closeMenu = () => {
    if (!(nav instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
    nav.hidden = true;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', 'Open navigation menu');
  };

  button?.addEventListener('click', () => {
    if (!(nav instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
    const willOpen = nav.hidden;
    nav.hidden = !willOpen;
    button.setAttribute('aria-expanded', String(willOpen));
    button.setAttribute('aria-label', willOpen ? 'Close navigation menu' : 'Open navigation menu');
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 760) closeMenu();
  }, { passive: true });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

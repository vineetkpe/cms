---
import site from '../data/site.json';
---
<header class="site-header">
  <div class="container masthead">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-mark">{(site.logoText || site.name).slice(0, 1).toUpperCase()}</span>
      <span>{site.logoText || site.name}</span>
    </a>
    <a class="header-search" href="/search/" aria-label="Search site">Search</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
  <div class="nav-bar">
    <div class="container">
      <nav class="desktop-nav" aria-label="Primary navigation">
        {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/articles/">All articles</a>
      </nav>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav container" aria-label="Mobile navigation" hidden>
    {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href="/articles/">All articles</a>
    <a href="/search/">Search</a>
  </nav>
</header>
<script is:inline>
  const button = document.querySelector('.menu-button');
  const nav = document.querySelector('#mobile-nav');
  button?.addEventListener('click', () => {
    if (!(nav instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    nav.hidden = isOpen;
  });
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, slugify } from '../../lib/posts';

export const prerender = false;

const authorSlug = String(Astro.params.author || '');
const allPosts = await getPublishedPosts();
const posts = allPosts.filter((post) => slugify(post.data.author) === authorSlug);
if (!posts.length) return Astro.redirect('/404/');
const name = posts[0].data.author;
const schema = { '@context': 'https://schema.org', '@type': 'Person', name };
---
<BaseLayout title={name} description={`Articles written by ${name}.`} schema={schema}>
  <section class="hero"><div class="container hero-copy"><div class="kicker">Author</div><h1>{name}</h1><p>{posts.length} published article{posts.length === 1 ? '' : 's'}.</p></div></section>
  <section class="section"><div class="container"><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></div></section>
</BaseLayout>

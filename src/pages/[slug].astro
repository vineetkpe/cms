---
import { render } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPublishedPostBySlug, getRelatedPublishedPosts, slugify } from '../lib/posts';
import { getSiteSettings } from '../lib/site-settings';

export const prerender = false;

const site = await getSiteSettings();
const slug = String(Astro.params.slug || '');
const post = await getPublishedPostBySlug(slug);
if (!post) return Astro.redirect('/404/');

let Content: any = null;
let articleHtml = '';
let headings: Array<{ depth: number; slug: string; text: string }> = [];

function markdownHeadings(markdown: string) {
  const seen = new Map<string, number>();
  return markdown.split('\n').flatMap((line) => {
    const match = line.match(/^(#{2,3})\s+(.+?)\s*#*\s*$/);
    if (!match) return [];
    const text = match[2].replace(/[*_`~\[\]]/g, '').trim();
    const base = slugify(text) || 'section';
    const count = seen.get(base) || 0;
    seen.set(base, count + 1);
    return [{ depth: match[1].length, slug: count ? `${base}-${count + 1}` : base, text }];
  });
}

if (post.__d1) {
  const markdown = String(post.body || '');
  headings = markdownHeadings(markdown);
  const rawHtml = String(await marked.parse(markdown));
  let headingIndex = 0;
  articleHtml = rawHtml.replace(/<h([23])>([\s\S]*?)<\/h\1>/g, (match, depth, inner) => {
    const heading = headings[headingIndex++];
    if (!heading) return match;
    return `<h${depth} id="${heading.slug}">${inner}</h${depth}>`;
  });
} else {
  const rendered = await render(post);
  Content = rendered.Content;
  headings = rendered.headings;
}

const related = await getRelatedPublishedPosts(post, 3);
const categorySlug = slugify(post.data.category);
const authorSlug = slugify(post.data.author);
const canonical = post.data.canonical || new URL(`/${slug}/`, site.url).toString();
const wordCount = String(post.body || '').trim().split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(wordCount / 220));
const showInlineAd = !post.data.hideAds && wordCount >= 500;
const showRailAd = !post.data.hideAds && wordCount >= 900;
const publishedAt = post.data.publishAt || post.data.pubDate;
const authorInitial = String(post.data.author || 'A').slice(0, 1).toUpperCase();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.seoTitle || post.data.title,
  description: post.data.seoDescription || post.data.description,
  image: post.data.featuredImage ? [new URL(post.data.featuredImage, site.url).toString()] : undefined,
  datePublished: publishedAt.toISOString(),
  dateModified: (post.data.updatedDate || publishedAt).toISOString(),
  author: { '@type': 'Person', name: post.data.author, url: new URL(`/author/${authorSlug}/`, site.url).toString() },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: canonical,
  wordCount,
  inLanguage: site.language || 'en'
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: post.data.category, item: new URL(`/category/${categorySlug}/`, site.url).toString() },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical }
  ]
};

const faqSchema = post.data.faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.data.faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
} : undefined;

const schemas = [articleSchema, breadcrumbSchema, faqSchema].filter(Boolean);
---
<BaseLayout
  title={post.data.seoTitle || post.data.title}
  description={post.data.seoDescription || post.data.description}
  canonical={canonical}
  image={post.data.featuredImage}
  socialTitle={post.data.ogTitle}
  socialDescription={post.data.ogDescription}
  socialImage={post.data.ogImage}
  noindex={post.data.noindex}
  nofollow={post.data.nofollow}
  schema={schemas}
  ogType="article"
  author={post.data.author}
  publishedTime={publishedAt.toISOString()}
  modifiedTime={(post.data.updatedDate || publishedAt).toISOString()}
  section={post.data.category}
  tags={post.data.tags}
  siteSettings={site}
>
  <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>

  <div class="container article-shell">
    <article class="article-main">
      <header class="article-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/category/${categorySlug}/`}>{post.data.category}</a>
        </nav>
        <a class="eyebrow" href={`/category/${categorySlug}/`}>{post.data.category}</a>
        <h1>{post.data.title}</h1>
        <p class="article-deck">{post.data.description}</p>
        <div class="article-meta">
          <span>By <a href={`/author/${authorSlug}/`}>{post.data.author}</a></span>
          <span aria-hidden="true">·</span>
          <time datetime={publishedAt.toISOString()}>{publishedAt.toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'})}</time>
          <span aria-hidden="true">·</span>
          <span>{readTime} min read</span>
          {post.data.updatedDate && <><span aria-hidden="true">·</span><span>Updated {post.data.updatedDate.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span></>}
        </div>

        <div class="article-actions" aria-label="Article actions">
          <button class="article-action" type="button" data-share>Share</button>
          <button class="article-action" type="button" data-copy>Copy link</button>
          <span class="article-action-status" data-action-status aria-live="polite"></span>
        </div>
      </header>

      {post.data.featuredImage && (
        <figure class="hero-image">
          <img src={post.data.featuredImage} alt={post.data.featuredImageAlt || post.data.title} width="1200" height="675" fetchpriority="high" decoding="async" />
        </figure>
      )}

      {headings.length > 0 && (
        <details class="toc-mobile">
          <summary>On this page</summary>
          <nav aria-label="Mobile table of contents">
            {headings.filter((h) => h.depth <= 3).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        </details>
      )}

      {post.__d1 ? <div class="article-content" set:html={articleHtml} /> : <div class="article-content"><Content /></div>}

      {showInlineAd && <AdSlot slot={site.adsenseArticleSlot} publisherId={site.adsensePublisherId} />}

      {post.data.faq.length > 0 && (
        <section class="faq-section" aria-labelledby="faq-title">
          <div class="kicker">Quick answers</div>
          <h2 id="faq-title">Frequently asked questions</h2>
          {post.data.faq.map((item: { question: string; answer: string }) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </section>
      )}

      <aside class="author-box" aria-label="About the author">
        <span class="author-box-avatar" aria-hidden="true">{authorInitial}</span>
        <div class="author-box-copy">
          <div class="kicker">Contributor</div>
          <strong>{post.data.author}</strong>
          <p>Explore more practical guides and updates from this contributor.</p>
        </div>
        <a href={`/author/${authorSlug}/`}>More articles →</a>
      </aside>

      <aside class="article-endnote" aria-label="Editorial information">
        <strong>About this article</strong>
        <p>Published in {post.data.category}. We may update this page when clearer or more useful information becomes available.</p>
      </aside>

      {post.data.tags.length > 0 && (
        <div class="tag-list" aria-label="Article tags">
          {post.data.tags.map((tag: string) => <a href={`/tag/${slugify(tag)}/`}>{tag}</a>)}
        </div>
      )}

      {related.length > 0 && (
        <section class="related-posts" aria-labelledby="related-title">
          <div class="section-head">
            <div><div class="kicker">Keep reading</div><h2 id="related-title">Related stories</h2></div>
          </div>
          <div class="related-grid">{related.map((item) => <PostCard post={item} compact={true} />)}</div>
        </section>
      )}
    </article>

    <aside class="article-rail" aria-label="Article tools">
      {headings.length > 0 && (
        <nav class="toc toc-rail" aria-label="Table of contents">
          <strong>On this page</strong>
          {headings.filter((h) => h.depth <= 3).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      )}
      {showRailAd && <AdSlot slot={site.adsenseSidebarSlot} format="vertical" publisherId={site.adsensePublisherId} />}
    </aside>
  </div>

  <script is:inline define:vars={{ slug, shareUrl: canonical, shareTitle: post.data.title }}>
    const status = document.querySelector('[data-action-status]');
    const setStatus = (message) => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      window.setTimeout(() => { status.textContent = ''; }, 2200);
    };

    const copyLink = async () => {
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const input = document.createElement('textarea');
        input.value = shareUrl;
        input.setAttribute('readonly', '');
        input.style.position = 'fixed';
        input.style.opacity = '0';
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        input.remove();
      }
      setStatus('Link copied');
    };

    document.querySelector('[data-copy]')?.addEventListener('click', copyLink);
    document.querySelector('[data-share]')?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title: shareTitle, url: shareUrl });
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
        }
      }
      await copyLink();
    });

    const article = document.querySelector('.article-main');
    const progress = document.querySelector('#reading-progress-bar');
    const updateProgress = () => {
      if (!(article instanceof HTMLElement) || !(progress instanceof HTMLElement)) return;
      const start = article.getBoundingClientRect().top + window.scrollY;
      const distance = Math.max(1, article.offsetHeight - window.innerHeight);
      const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
      progress.style.transform = `scaleX(${value})`;
    };
    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });

    try {
      const key = `cms-view:${slug}:${new Date().toISOString().slice(0,10)}`;
      if (!sessionStorage.getItem(key)) {
        sessionStorage.setItem(key, '1');
        fetch('/api/view', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({slug}), keepalive:true }).catch(()=>{});
      }
    } catch {}
  </script>
</BaseLayout>

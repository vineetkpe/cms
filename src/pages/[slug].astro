---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPublishedPosts, getRelatedPosts, slugify, type PostEntry } from '../lib/posts';
import site from '../data/site.json';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id.replace(/\.md$/, '') }, props: { post } }));
}

const { post } = Astro.props as { post: PostEntry };
const { Content, headings } = await render(post);
const allPosts = await getPublishedPosts();
const related = getRelatedPosts(post, allPosts, 3);
const slug = post.id.replace(/\.md$/, '');
const categorySlug = slugify(post.data.category);
const authorSlug = slugify(post.data.author);
const canonical = post.data.canonical || new URL(`/${slug}/`, site.url).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.seoTitle || post.data.title,
  description: post.data.seoDescription || post.data.description,
  image: post.data.featuredImage ? [new URL(post.data.featuredImage, site.url).toString()] : undefined,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: post.data.author, url: new URL(`/author/${authorSlug}/`, site.url).toString() },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: canonical
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: post.data.category, item: new URL(`/category/${categorySlug}/`, site.url).toString() },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical }
  ]
};
const faqSchema = post.data.faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
} : undefined;
const schemas = [articleSchema, breadcrumbSchema, faqSchema].filter(Boolean);
---
<BaseLayout title={post.data.seoTitle || post.data.title} description={post.data.seoDescription || post.data.description} canonical={canonical} image={post.data.featuredImage} noindex={post.data.noindex} schema={schemas}>
  <div class="container article-shell">
    <article>
      <header class="article-header">
        <div class="breadcrumbs"><a href="/">Home</a> / <a href={`/category/${categorySlug}/`}>{post.data.category}</a></div>
        <div class="eyebrow">{post.data.category}</div>
        <h1>{post.data.title}</h1>
        <p class="article-deck">{post.data.description}</p>
        <div class="article-meta">By <a href={`/author/${authorSlug}/`}>{post.data.author}</a> · {post.data.pubDate.toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'})}{post.data.updatedDate && ` · Updated ${post.data.updatedDate.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}`}</div>
      </header>
      {post.data.featuredImage && <figure class="hero-image"><img src={post.data.featuredImage} alt={post.data.featuredImageAlt || post.data.title} width="1200" height="675" fetchpriority="high" decoding="async" /></figure>}
      {!post.data.hideAds && <AdSlot slot={site.adsenseArticleSlot} />}
      <div class="article-content"><Content /></div>
      {post.data.faq.length > 0 && (
        <section class="faq-section" aria-labelledby="faq-title">
          <h2 id="faq-title">Frequently asked questions</h2>
          {post.data.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </section>
      )}
      {post.data.tags.length > 0 && <div class="tag-list" aria-label="Article tags">{post.data.tags.map((tag) => <a href={`/tag/${slugify(tag)}/`}>{tag}</a>)}</div>}
      {related.length > 0 && (
        <section class="related-posts">
          <div class="section-head"><h2>Related articles</h2></div>
          <div class="post-grid">{related.map((item) => <PostCard post={item} />)}</div>
        </section>
      )}
    </article>
    <aside class="article-rail">
      {headings.length > 0 && <nav class="toc" aria-label="Table of contents"><strong>On this page</strong>{headings.filter((h) => h.depth <= 3).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>}
      {!post.data.hideAds && <AdSlot slot={site.adsenseSidebarSlot} format="vertical" />}
    </aside>
  </div>
</BaseLayout>

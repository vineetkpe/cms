---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, slugify } from '../../lib/posts';

export const prerender = false;

const categorySlug = String(Astro.params.category || '');
const allPosts = await getPublishedPosts();
const posts = allPosts.filter((post) => slugify(post.data.category) === categorySlug);
if (!posts.length) return Astro.redirect('/404/');
const name = posts[0].data.category;
---
<BaseLayout title={name} description={`Latest ${name} articles and guides.`}>
  <section class="hero">
    <div class="container hero-copy">
      <div class="kicker">Category</div>
      <h1>{name}</h1>
      <p>{posts.length} article{posts.length === 1 ? '' : 's'} in {name}.</p>
    </div>
  </section>
  <section class="section">
    <div class="container"><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></div>
  </section>
</BaseLayout>

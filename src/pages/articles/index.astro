---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedCategoryCounts, getPublishedPostPage } from '../../lib/posts';
import { getSiteSettings } from '../../lib/site-settings';

const site = await getSiteSettings();
const perPage = 18;
const [{ posts, total }, categories] = await Promise.all([
  getPublishedPostPage(perPage, 0),
  getPublishedCategoryCounts(),
]);
const pages = Math.max(1, Math.ceil(total / perPage));
const canonical = new URL('/articles/', site.url).toString();
const breadcrumbSchema = {
  '@context':'https://schema.org','@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:'Home',item:site.url},
    {'@type':'ListItem',position:2,name:'All Updates',item:canonical}
  ]
};
---
<BaseLayout title="Latest Job, Exam, Result, Scholarship & Scheme Updates" description="Browse the latest job, exam, result, scholarship and government scheme updates from the complete publication archive." canonical={canonical} schema={breadcrumbSchema} schemaType="CollectionPage" siteSettings={site}>
  <section class="hero">
    <div class="container hero-copy archive-hero-grid">
      <div><div class="kicker">Publication archive</div><h1>All updates</h1><p>Browse the complete publication archive, organized for fast discovery and easy reading.</p></div>
      <div class="archive-summary" aria-label="Archive summary"><div><strong>{total}</strong><span>published articles</span></div><div><strong>{categories.length}</strong><span>topics</span></div></div>
    </div>
  </section>
  <section class="section"><div class="container"><div class="archive-tools"><p>Newest articles appear first.</p><a class="hero-archive-link" href="/search/">Search publication →</a></div><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>{pages > 1 && <nav class="archive-pagination" aria-label="Article archive pagination"><span>Page 1 of {pages}</span><a href="/articles/2/">Next →</a></nav>}</div></section>
</BaseLayout>

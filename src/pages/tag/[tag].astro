---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, slugify } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags as string[]))] as string[];
  return tags.map((name) => ({
    params: { tag: slugify(name) },
    props: { name, posts: posts.filter((post) => post.data.tags.some((tag: string) => slugify(tag) === slugify(name))) }
  }));
}
const { name, posts } = Astro.props;
---
<BaseLayout title={name} description={`Articles tagged ${name}.`}>
  <section class="hero"><div class="container hero-copy"><div class="kicker">Tag</div><h1>{name}</h1><p>{posts.length} article{posts.length === 1 ? '' : 's'} tagged {name}.</p></div></section>
  <section class="section"><div class="container"><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></div></section>
</BaseLayout>

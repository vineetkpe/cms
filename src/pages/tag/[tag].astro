---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, slugify } from '../../lib/posts';

export const prerender = false;

const tagSlug = String(Astro.params.tag || '');
const allPosts = await getPublishedPosts();
const posts = allPosts.filter((post) => post.data.tags.some((tag: string) => slugify(tag) === tagSlug));
if (!posts.length) return Astro.redirect('/404/');
const name = posts.flatMap((post) => post.data.tags as string[]).find((tag) => slugify(tag) === tagSlug) || tagSlug;
---
<BaseLayout title={name} description={`Articles tagged ${name}.`}>
  <section class="hero"><div class="container hero-copy"><div class="kicker">Tag</div><h1>{name}</h1><p>{posts.length} article{posts.length === 1 ? '' : 's'} tagged {name}.</p></div></section>
  <section class="section"><div class="container"><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></div></section>
</BaseLayout>

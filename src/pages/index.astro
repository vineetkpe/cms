---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, slugify } from '../lib/posts';
import { getSiteSettings } from '../lib/site-settings';

export const prerender = false;

const site = await getSiteSettings();
const posts = await getPublishedPosts();
const builtIns = ['Job Updates','Exam Updates','Result Updates','Scholarship','Scheme'];
const categories = builtIns.map((name) => ({
  name,
  count: posts.filter((post) => post.data.category === name).length,
  latest: posts.find((post) => post.data.category === name),
}));
const featured = posts.find((post) => post.data.featured) || posts[0];
const latest = posts.slice(0, 10);
const secondary = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
---
<BaseLayout title={site.name} description={site.description} siteSettings={site}>
  <section class="news-hero">
    <div class="container news-hero-grid">
      <div>
        <div class="kicker">{site.homepageEyebrow || 'Latest verified updates'}</div>
        <h1>{site.tagline}</h1>
        <p>{site.description}</p>
        <div class="hero-actions"><a class="primary-link" href="/articles/">Browse all updates</a><a class="secondary-link" href="/search/">Search the site</a></div>
      </div>
      <aside class="hero-status" aria-label="Publication status">
        <strong>Latest coverage</strong>
        <div><span>Published updates</span><b>{posts.length}</b></div>
        <div><span>Update categories</span><b>{builtIns.length}</b></div>
        <div><span>Last refreshed</span><b>{posts[0] ? posts[0].data.pubDate.toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) : '—'}</b></div>
      </aside>
    </div>
  </section>

  <section class="quick-categories" aria-labelledby="quick-categories-title">
    <div class="container">
      <div class="section-head compact-head"><div><div class="kicker">Browse quickly</div><h2 id="quick-categories-title">What are you looking for?</h2></div><a href="/categories/">All categories →</a></div>
      <div class="category-action-grid">
        {categories.map((item) => <a class="category-action" href={`/category/${slugify(item.name)}/`}><span>{item.name}</span><strong>{item.count}</strong><small>{item.count ? 'View latest updates' : 'No update published yet'}</small></a>)}
      </div>
    </div>
  </section>

  {featured && <section class="section featured-section">
    <div class="container">
      <div class="section-label-row"><h2>Featured update</h2><span>Important reading selected from the latest coverage</span></div>
      <div class="lead-grid"><PostCard post={featured} featured={true} /><div class="lead-side">{secondary.map((post) => <PostCard post={post} compact={true} />)}</div></div>
    </div>
  </section>}

  <section class="section updates-section" aria-labelledby="latest-updates-title">
    <div class="container updates-layout">
      <div>
        <div class="section-head"><div><div class="kicker">Newest first</div><h2 id="latest-updates-title">Latest updates</h2></div><a href="/articles/">View archive →</a></div>
        {latest.length ? <div class="update-feed">{latest.map((post) => <PostCard post={post} compact={true} />)}</div> : <div class="empty">No published updates yet.</div>}
      </div>
      <aside class="reader-panel">
        <div class="reader-panel-block"><strong>Useful links</strong><a href="/search/">Search updates <span>→</span></a><a href="/categories/">Browse categories <span>→</span></a><a href="/editorial-policy/">Editorial standards <span>→</span></a><a href="/corrections-policy/">Corrections policy <span>→</span></a></div>
        <div class="reader-note"><strong>Before you apply</strong><p>Always confirm deadlines, eligibility, fees and official links on the issuing authority’s website.</p></div>
      </aside>
    </div>
  </section>
</BaseLayout>

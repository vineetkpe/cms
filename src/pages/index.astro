---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, slugify } from '../lib/posts';
import site from '../data/site.json';

const posts = await getPublishedPosts();
const featured = posts.find((post) => post.data.featured) || posts[0];
const secondary = posts.filter((post) => post.id !== featured?.id).slice(0, 2);
const latest = posts.filter((post) => post.id !== featured?.id && !secondary.some((item) => item.id === post.id)).slice(0, 8);
const categoryNames = [...new Set(posts.map((post) => post.data.category))].slice(0, 4);
---
<BaseLayout title={site.name} description={site.description}>
  <section class="publication-intro">
    <div class="container intro-inner">
      <div>
        <div class="kicker">Latest updates & practical guides</div>
        <h1>{site.name}</h1>
      </div>
      <p>{site.tagline}</p>
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      {featured ? (
        <div class="lead-grid">
          <PostCard post={featured} featured={true} />
          <div class="lead-side">
            {secondary.map((post) => <PostCard post={post} compact={true} />)}
          </div>
        </div>
      ) : <div class="empty">Publish your first article from the admin dashboard.</div>}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section latest-section">
      <div class="container">
        <div class="section-head"><h2>Latest articles</h2><a href="/articles/">View all</a></div>
        <div class="latest-grid">{latest.map((post) => <PostCard post={post} />)}</div>
      </div>
    </section>
  )}

  {categoryNames.map((name) => {
    const categoryPosts = posts.filter((post) => post.data.category === name).slice(0, 4);
    if (!categoryPosts.length) return null;
    return (
      <section class="section category-strip">
        <div class="container">
          <div class="section-head"><h2>{name}</h2><a href={`/category/${slugify(name)}/`}>More {name}</a></div>
          <div class="category-grid">{categoryPosts.map((post) => <PostCard post={post} compact={true} />)}</div>
        </div>
      </section>
    );
  })}
</BaseLayout>

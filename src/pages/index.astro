---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, slugify } from '../lib/posts';
import { getSiteSettings } from '../lib/site-settings';

export const prerender = false;

const site = await getSiteSettings();
const posts = await getPublishedPosts();
const featured = posts.find((post) => post.data.featured) || posts[0];
const remaining = posts.filter((post) => post.id !== featured?.id);
const secondary = remaining.slice(0, 2);
const latest = remaining.slice(2, 8);
const categoryNames = [...new Set(posts.map((post) => post.data.category))].slice(0, 8);
const authorCount = new Set(posts.map((post) => post.data.author)).size;
const topicCards = categoryNames.slice(0, 4).map((name) => ({
  name,
  count: posts.filter((post) => post.data.category === name).length,
}));
---
<BaseLayout title={site.name} description={site.description} siteSettings={site}>
  <section class="front-intro">
    <div class="container front-intro-grid">
      <div class="front-intro-copy">
        <div class="kicker">{site.homepageEyebrow || site.name}</div>
        <h1>{site.tagline}</h1>
        <p>{site.description}</p>
      </div>
      <div class="front-facts" aria-label="Publication summary">
        <div class="front-fact"><strong>{posts.length}</strong><span>published stories</span></div>
        <div class="front-fact"><strong>{categoryNames.length}</strong><span>active topics</span></div>
        <div class="front-fact"><strong>{authorCount}</strong><span>contributor{authorCount === 1 ? '' : 's'}</span></div>
      </div>
    </div>
  </section>

  {categoryNames.length > 0 && (
    <nav class="topic-strip" aria-label="Browse article categories">
      <div class="container topic-strip-inner">
        <a class="topic-link is-active" href="/">Latest</a>
        {categoryNames.map((name) => <a class="topic-link" href={`/category/${slugify(name)}/`}>{name}</a>)}
      </div>
    </nav>
  )}

  <section class="section section-first" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-label-row">
        <h2 id="featured-heading">Featured</h2>
        <span>Start with our latest recommended read</span>
      </div>
      {featured ? (
        <div class="lead-grid">
          <PostCard post={featured} featured={true} />
          {secondary.length > 0 && (
            <div class="lead-side">
              {secondary.map((post) => <PostCard post={post} compact={true} />)}
            </div>
          )}
        </div>
      ) : <div class="empty">Publish your first article from the admin dashboard.</div>}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section" aria-labelledby="latest-heading">
      <div class="container">
        <div class="section-head">
          <div><div class="kicker">Fresh from the desk</div><h2 id="latest-heading">Latest stories</h2></div>
          <a href="/articles/">View all articles →</a>
        </div>
        <div class="latest-grid">{latest.map((post) => <PostCard post={post} />)}</div>
      </div>
    </section>
  )}

  {topicCards.length > 0 && (
    <section class="section" aria-labelledby="topics-heading">
      <div class="container">
        <div class="section-head">
          <div><div class="kicker">Browse</div><h2 id="topics-heading">Explore by topic</h2></div>
        </div>
        <div class="topic-grid">
          {topicCards.map((item) => (
            <a class="topic-card" href={`/category/${slugify(item.name)}/`}>
              <strong>{item.name}</strong>
              <span>{item.count} article{item.count === 1 ? '' : 's'} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

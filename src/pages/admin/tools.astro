---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>CMS Tools & Backups</title>
  <style>
    :root{--bg:#f4f6f9;--panel:#fff;--text:#101828;--muted:#667085;--line:#e3e8ef;--accent:#1769e0;--danger:#b42318;--ok:#027a48}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit}.shell{display:grid;grid-template-columns:230px minmax(0,1fr);min-height:100vh}.side{background:#101828;color:#d0d5dd;padding:24px 16px;position:sticky;top:0;height:100vh}.brand{font-weight:850;color:#fff;font-size:1.2rem;padding:0 8px;margin-bottom:24px}.nav{display:grid;gap:3px}.nav a{color:#b7c0ce;text-decoration:none;padding:10px 11px;border-radius:8px}.nav a:hover,.nav a.active{background:#202939;color:#fff}.main{padding:28px;min-width:0}.top{margin-bottom:22px}.top h1{margin:0;font-size:1.85rem;letter-spacing:-.035em}.top p{margin:5px 0 0;color:var(--muted)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:18px;box-shadow:0 4px 18px rgba(16,24,40,.025)}.wide{grid-column:1/-1}.card h2{margin:0 0 6px;font-size:1.05rem}.card p{margin:0 0 14px;color:var(--muted);line-height:1.55;font-size:.88rem}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid var(--line);background:#fff;color:#344054;border-radius:8px;padding:9px 13px;font-weight:750;cursor:pointer}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn.danger{color:var(--danger)}.notice{display:none;margin-bottom:15px;padding:11px 13px;border-radius:9px}.notice.show{display:block}.notice.ok{background:#ecfdf3;color:var(--ok)}.notice.err{background:#fef3f2;color:var(--danger)}input,textarea{width:100%;border:1px solid #d8dee8;border-radius:8px;padding:10px 11px}.template{display:grid;grid-template-columns:180px 1fr 42px;gap:8px;margin-top:10px;align-items:start}.template textarea{min-height:140px;resize:vertical}.template-meta{display:grid;gap:8px}.muted{font-size:.78rem;color:var(--muted)}.import-result{white-space:pre-wrap;background:#f8fafc;border:1px solid var(--line);padding:12px;border-radius:8px;margin-top:12px;max-height:240px;overflow:auto}.health{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.health-item{border:1px solid var(--line);border-radius:9px;padding:12px}.health-item strong{display:block}.health-item span{font-size:.78rem;color:var(--muted)}@media(max-width:900px){.shell{grid-template-columns:1fr}.side{position:static;height:auto;padding:12px}.brand{margin-bottom:8px}.nav{display:flex;overflow:auto}.nav a{white-space:nowrap}.main{padding:18px}.grid{grid-template-columns:1fr}.wide{grid-column:auto}}@media(max-width:650px){.template{grid-template-columns:1fr}.health{grid-template-columns:1fr}}
  </style>
</head>
<body>
<div class="shell">
  <aside class="side"><div class="brand">CMS Admin</div><nav class="nav"><a href="/admin/">Dashboard</a><a href="/admin/editor/">Publishing Studio</a><a href="/admin/content/">Posts</a><a href="/admin/media/">Media</a><a href="/admin/pages/">Pages</a><a class="active" href="/admin/tools/">Tools & backups</a><a href="/admin/settings/">Appearance</a><a href="/" target="_blank">View website ↗</a></nav></aside>
  <main class="main" id="app" hidden>
    <div class="notice" id="notice"></div>
    <div class="top"><h1>Tools & backups</h1><p>Portable exports, migration tools, D1-backed content templates and system checks.</p></div>
    <div class="grid">
      <section class="card"><h2>Portable CMS backup</h2><p>Download CMS content and configuration in a portable JSON backup.</p><div class="actions"><a class="btn primary" href="/api/admin/backup?format=json">Download JSON backup</a></div></section>
      <section class="card"><h2>WordPress export</h2><p>Generate a WordPress WXR 1.2 XML file containing posts, managed pages, categories, tags, authors and key SEO metadata.</p><div class="actions"><a class="btn primary" href="/api/admin/backup?format=wxr">Download WordPress XML</a></div></section>
      <section class="card"><h2>Restore / import backup</h2><p>Import a CMS JSON backup. The first pass is always a dry run so you can review conflicts before anything is written.</p><input id="backupFile" type="file" accept="application/json,.json" /><div class="actions" style="margin-top:10px"><button class="btn" id="dryRun">Check backup</button><button class="btn danger" id="restore" disabled>Restore and overwrite</button></div><div id="importResult" class="import-result" hidden></div></section>
      <section class="card"><h2>System health</h2><p>Quick checks for authentication, content repository access and publishing APIs.</p><div class="health"><div class="health-item"><strong id="hAuth">Checking…</strong><span>Admin session</span></div><div class="health-item"><strong id="hPosts">Checking…</strong><span>D1 content</span></div><div class="health-item"><strong id="hTemplates">Checking…</strong><span>Templates</span></div></div></section>
      <section class="card wide"><h2>Post templates</h2><p>These are safe content templates, not executable theme code. They speed up writing without letting an editor accidentally break the site.</p><div id="templateList"></div><div class="actions" style="margin-top:12px"><button class="btn" id="addTemplate">+ Add template</button><button class="btn primary" id="saveTemplates">Save templates</button></div><div class="muted" style="margin-top:8px">Templates are stored in D1 and update immediately.</div></section>
    </div>
  </main>
</div>
<script is:inline>
  const $=id=>document.getElementById(id);let templateSha='',templates=[],checkedBackup=null;
  async function api(url,options={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(options.headers||{})},...options});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||`Request failed (${r.status})`);return data}
  function notice(text,ok=true){const el=$('notice');el.textContent=text;el.className=`notice show ${ok?'ok':'err'}`;setTimeout(()=>el.classList.remove('show'),5000)}
  function templateRow(item={id:'',name:'',description:'',body:''}){const row=document.createElement('div');row.className='template';const meta=document.createElement('div');meta.className='template-meta';const id=document.createElement('input');id.placeholder='template-id';id.value=item.id||'';id.dataset.k='id';const name=document.createElement('input');name.placeholder='Template name';name.value=item.name||'';name.dataset.k='name';const desc=document.createElement('input');desc.placeholder='Short description';desc.value=item.description||'';desc.dataset.k='description';meta.append(id,name,desc);const body=document.createElement('textarea');body.placeholder='Markdown template body';body.value=item.body||'';body.dataset.k='body';const del=document.createElement('button');del.className='btn danger';del.textContent='×';del.onclick=()=>row.remove();row.append(meta,body,del);return row}
  function renderTemplates(){const root=$('templateList');root.innerHTML='';templates.forEach(t=>root.append(templateRow(t)))}
  function collectTemplates(){return[...$('templateList').querySelectorAll('.template')].map(row=>({id:row.querySelector('[data-k=id]').value.trim(),name:row.querySelector('[data-k=name]').value.trim(),description:row.querySelector('[data-k=description]').value.trim(),body:row.querySelector('[data-k=body]').value.trim()})).filter(t=>t.id||t.name||t.body)}
  async function loadTemplates(){try{const data=await api('/api/admin/templates');templates=data.templates||[];templateSha=data.sha||'';renderTemplates();$('hTemplates').textContent='OK'}catch(e){$('hTemplates').textContent='Error';notice(e.message,false)}}
  $('addTemplate').onclick=()=>$('templateList').append(templateRow());$('saveTemplates').onclick=async()=>{try{await api('/api/admin/templates',{method:'PUT',body:JSON.stringify({templates:collectTemplates(),sha:templateSha})});templateSha='';await loadTemplates();notice('Templates saved.')}catch(e){notice(e.message,false)}};
  async function readBackup(){const file=$('backupFile').files?.[0];if(!file)throw new Error('Choose a JSON backup first.');if(file.size>10*1024*1024)throw new Error('Backup must be under 10 MB.');return JSON.parse(await file.text())}
  function showResult(data){const el=$('importResult');el.hidden=false;el.textContent=JSON.stringify(data,null,2)}
  $('dryRun').onclick=async()=>{try{checkedBackup=await readBackup();const result=await api('/api/admin/backup',{method:'POST',body:JSON.stringify({backup:checkedBackup,confirm:false})});showResult(result);$('restore').disabled=false;notice('Backup check completed. Review the conflicts before restoring.')}catch(e){checkedBackup=null;$('restore').disabled=true;notice(e.message,false)}};
  $('restore').onclick=async()=>{if(!checkedBackup)return;if(!confirm('Restore this backup and overwrite matching CMS content files? Git history will still preserve the current versions.'))return;try{const result=await api('/api/admin/backup',{method:'POST',body:JSON.stringify({backup:checkedBackup,confirm:true,overwrite:true})});showResult(result);notice('Backup restored. A site build will apply restored content.')}catch(e){notice(e.message,false)}};
  async function boot(){try{const auth=await api('/api/admin/login');if(!auth.authenticated)throw new Error('Not signed in');$('hAuth').textContent='OK';$('app').hidden=false;try{await api('/api/admin/posts');$('hPosts').textContent='OK'}catch(e){$('hPosts').textContent='Error'}await loadTemplates()}catch{location.replace('/admin/login/')}}boot();
</script>
</body>
</html>

---
export const prerender = true;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Connections · CMS</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#172033;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.main{padding:28px 30px 70px}.top{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:20px}.top h1{margin:0;font-size:1.75rem}.top p{margin:5px 0 0;color:#7a8494;font-size:.84rem}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid #dfe3ea;background:#fff;border-radius:10px;padding:9px 13px;text-decoration:none;color:#475467;font-weight:750;cursor:pointer}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.card{background:#fff;border:1px solid #e7eaf0;border-radius:16px;padding:17px;box-shadow:0 10px 30px rgba(16,24,40,.045)}.check{display:flex;gap:12px;align-items:flex-start}.ico{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-weight:900;background:#f2f4f7;color:#667085}.check.ok .ico{background:#ecfdf3;color:#027a48}.check.warning .ico{background:#fff6ed;color:#b54708}.check.error .ico{background:#fef3f2;color:#b42318}.check h2{font-size:.92rem;margin:0 0 4px}.check p{margin:0;color:#667085;font-size:.78rem;line-height:1.5}.status{margin-left:auto;border-radius:999px;padding:4px 7px;font-size:.65rem;font-weight:850;text-transform:uppercase}.ok .status{background:#ecfdf3;color:#027a48}.warning .status{background:#fff6ed;color:#b54708}.error .status{background:#fef3f2;color:#b42318}.notice{background:#fff;border:1px solid #e7eaf0;border-radius:14px;padding:14px 16px;margin-bottom:15px;color:#667085;font-size:.79rem;line-height:1.55}.loading{padding:30px;color:#98a2b3}.footer{margin-top:16px;color:#98a2b3;font-size:.72rem}@media(max-width:760px){.grid{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}}</style></head><body><main class="main" id="app" hidden><div class="top"><div><div class="cms-page-kicker">System</div><h1>Connections & health</h1><p>See exactly which CMS services are connected and what still needs attention.</p></div><div class="actions"><button class="btn" id="refresh">Refresh checks</button><a class="btn" href="https://dash.cloudflare.com/" target="_blank" rel="noopener">Cloudflare settings ↗</a></div></div><div class="notice">Secrets are never displayed here. This screen only checks whether required bindings/credentials exist and whether the CMS can reach them.</div><div id="grid" class="grid"><div class="card loading">Checking integrations…</div></div><div class="footer" id="time"></div></main><script is:inline>const $=id=>document.getElementById(id);const esc=v=>String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));async function api(url){const r=await fetch(url,{credentials:'same-origin',cache:'no-store'}),d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}function render(data){$('grid').innerHTML=(data.checks||[]).map(c=>`<article class="card check ${esc(c.status)}"><div class="ico">${c.status==='ok'?'✓':c.status==='error'?'!':'•'}</div><div><h2>${esc(c.label)}</h2><p>${esc(c.detail)}</p></div><span class="status">${esc(c.status)}</span></article>`).join('')||'<div class="card loading">No checks returned.</div>';$('time').textContent=`Last checked ${new Date(data.generatedAt||Date.now()).toLocaleString()}`}async function load(){try{render(await api('/api/admin/system'))}catch(e){$('grid').innerHTML=`<div class="card loading">${esc(e.message)}</div>`}}$('refresh').onclick=load;api('/api/admin/login').then(d=>{if(!d.authenticated)throw new Error();$('app').hidden=false;load()}).catch(()=>location.replace('/admin/login/'));</script></body></html>

---
export const prerender = true;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Manage Pages</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f7fa;color:#111827;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.wrap{width:min(calc(100% - 32px),900px);margin:0 auto;padding:38px 0 70px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.top h1{margin:0;font-size:2rem}.back{color:#1769e0;text-decoration:none;font-weight:700}.panel{background:#fff;border:1px solid #e2e7ee;border-radius:14px;padding:22px}.field{display:grid;gap:6px;margin-bottom:16px}label{font-size:.84rem;font-weight:750}input,textarea,select{font:inherit;width:100%;padding:10px 11px;border:1px solid #d0d5dd;border-radius:8px}textarea{min-height:340px;line-height:1.6}.actions{display:flex;gap:9px;align-items:center}.button{border:1px solid #d0d5dd;background:#fff;border-radius:8px;padding:9px 13px;font-weight:750;cursor:pointer}.primary{background:#1769e0;color:#fff;border-color:#1769e0}.msg{margin-bottom:14px;padding:10px 12px;border-radius:8px;display:none}.msg.show{display:block}.ok{background:#ecfdf3;color:#027a48}.err{background:#fef3f2;color:#b42318}.hint{font-size:.8rem;color:#667085}</style></head><body><main class="wrap"><div class="top"><div><div class="hint">CMS</div><h1>Trust & legal pages</h1></div><a class="back" href="/admin/">← Control center</a></div><div id="msg" class="msg"></div><div class="panel"><div class="field"><label>Page</label><select id="pageSelect"><option value="about">About</option><option value="contact">Contact</option><option value="editorialPolicy">Editorial Policy</option><option value="privacy">Privacy Policy</option><option value="terms">Terms of Use</option><option value="disclaimer">Disclaimer</option></select></div><div class="field"><label>Eyebrow / kicker</label><input id="kicker"></div><div class="field"><label>Title</label><input id="title" maxlength="120"></div><div class="field"><label>Meta description</label><textarea id="description" style="min-height:85px" maxlength="320"></textarea></div><div class="field"><label>Body</label><textarea id="body"></textarea><div class="hint">Use blank lines for paragraphs, “## Heading” for section headings, and “- item” lines for lists.</div></div><div class="actions"><button class="button primary" id="save">Save pages</button><a class="button" id="view" target="_blank">Preview public page ↗</a></div></div></main><script is:inline>const $=id=>document.getElementById(id);let pages={},sha='';const routes={about:'/about/',contact:'/contact/',editorialPolicy:'/editorial-policy/',privacy:'/privacy/',terms:'/terms/',disclaimer:'/disclaimer/'};function msg(t,ok=true){const e=$('msg');e.textContent=t;e.className=`msg show ${ok?'ok':'err'}`;setTimeout(()=>e.classList.remove('show'),4500)}async function api(url,opt={}){const r=await fetch(url,{headers:{'Content-Type':'application/json'},...opt}),d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}function fill(){const key=$('pageSelect').value,p=pages[key]||{};$('kicker').value=p.kicker||'';$('title').value=p.title||'';$('description').value=p.description||'';$('body').value=p.body||'';$('view').href=routes[key]}function capture(){const key=$('pageSelect').value;pages[key]={kicker:$('kicker').value,title:$('title').value,description:$('description').value,body:$('body').value}}$('pageSelect').onchange=()=>{fill()};$('save').onclick=async()=>{capture();try{await api('/api/admin/pages',{method:'PUT',body:JSON.stringify({pages,sha})});msg('Pages saved. The next build will publish the changes.');const d=await api('/api/admin/pages');pages=d.pages;sha=d.sha}catch(e){msg(e.message,false)}};api('/api/admin/pages').then(d=>{pages=d.pages;sha=d.sha;fill()}).catch(e=>msg(e.message,false));</script></body></html>

---
export const prerender = true;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Pages & SEO · CMS</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#172033;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.main{padding:28px 30px 70px}.top{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:20px}.top h1{margin:0;font-size:1.75rem}.top p{margin:5px 0 0;color:#7a8494;font-size:.84rem}.actions{display:flex;gap:8px;flex-wrap:wrap}.button{border:1px solid #dfe3ea;background:#fff;border-radius:10px;padding:9px 13px;text-decoration:none;color:#475467;font-weight:750;cursor:pointer}.button.primary{background:#6d3df5;border-color:#6d3df5;color:#fff}.layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:15px}.panel{background:#fff;border:1px solid #e7eaf0;border-radius:16px;box-shadow:0 10px 30px rgba(16,24,40,.045);overflow:hidden}.page-list{padding:8px}.page-btn{width:100%;border:0;background:transparent;text-align:left;padding:11px 12px;border-radius:10px;cursor:pointer;color:#667085}.page-btn:hover{background:#f8f7ff}.page-btn.active{background:#f1ecff;color:#6032dc}.page-btn strong{display:block;font-size:.8rem}.page-btn span{display:block;font-size:.68rem;margin-top:2px;opacity:.75}.editor{padding:18px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:grid;gap:6px;margin-bottom:13px}.field label{font-size:.78rem;font-weight:800}.field small{font-size:.7rem;color:#98a2b3}.field input,.field textarea{width:100%;border:1px solid #dfe3ea;border-radius:10px;padding:10px 11px;font:inherit}.field textarea{resize:vertical;line-height:1.55}.body{min-height:340px}.divider{height:1px;background:#edf0f3;margin:18px 0}.section-title{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:#98a2b3;font-weight:850;margin-bottom:11px}.search-preview{border:1px solid #e5e8ed;border-radius:12px;padding:13px;background:#fbfcfe}.search-url{font-size:.7rem;color:#188038;margin-bottom:3px}.search-title{font-size:1rem;color:#1a0dab;margin-bottom:3px}.search-desc{font-size:.76rem;color:#4d5156;line-height:1.45}.check{display:flex;align-items:center;gap:8px;font-size:.78rem}.check input{width:auto}.msg{display:none;margin-bottom:13px;padding:10px 12px;border-radius:10px}.msg.show{display:block}.ok{background:#ecfdf3;color:#027a48}.err{background:#fef3f2;color:#b42318}@media(max-width:820px){.layout{grid-template-columns:1fr}.page-list{display:flex;overflow:auto}.page-btn{min-width:150px}.grid2{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}}</style></head><body><main class="main" id="app" hidden><div class="top"><div><div class="cms-page-kicker">Trust & information</div><h1>Pages & SEO</h1><p>Edit core site pages and control how each page appears in search and social previews.</p></div><div class="actions"><a id="view" class="button" target="_blank">View page ↗</a><button class="button primary" id="save">Save pages</button></div></div><div id="msg" class="msg"></div><div class="layout"><aside class="panel"><div class="page-list" id="pageList"></div></aside><section class="panel editor"><div class="grid2"><div class="field"><label>Eyebrow / kicker</label><input id="kicker" maxlength="80"></div><div class="field"><label>Page title</label><input id="title" maxlength="120"></div></div><div class="field"><label>Page summary / excerpt</label><textarea id="description" rows="3" maxlength="320"></textarea><small>Used on the page and as the fallback meta description. <span id="descCount">0</span>/320 characters</small></div><div class="field"><label>Page body</label><textarea id="body" class="body"></textarea><small>Supports paragraphs, “## Heading” and “- item” lists.</small></div><div class="divider"></div><div class="section-title">Search & social</div>
<div class="field"><label>SEO title</label><input id="seoTitle" maxlength="180" placeholder="Defaults to page title"><small>Search title. Aim for a concise, descriptive title.</small></div>
<div class="field"><label>SEO / meta description</label><textarea id="seoDescription" rows="3" maxlength="320" placeholder="Defaults to page summary"></textarea><small><span id="seoDescCount">0</span>/320 characters</small></div>
<div class="grid2"><div class="field"><label>Canonical URL</label><input id="canonical" type="url" placeholder="https://example.com/page/"></div><div class="field"><label>Social image</label><input id="ogImage" placeholder="/media/image.webp or https://…"></div></div>
<div class="field"><label>Social image alt text</label><input id="ogImageAlt" maxlength="180" placeholder="Describe the social image"></div>
<div class="grid2"><div class="field"><label>Social title</label><input id="socialTitle" maxlength="180" placeholder="Defaults to SEO title"></div><div class="field"><label>Social description</label><textarea id="socialDescription" rows="2" maxlength="320" placeholder="Defaults to SEO description"></textarea></div></div>
<label class="check"><input id="noindex" type="checkbox"> Hide this page from search engines (noindex)</label><div class="divider"></div><div class="section-title">Search preview</div><div class="search-preview"><div id="previewUrl" class="search-url"></div><div id="previewTitle" class="search-title"></div><div id="previewDesc" class="search-desc"></div></div></section></div></main><script is:inline>const $=id=>document.getElementById(id);let pages={},sha='d1',current='about',dirty=false;const defs=[['about','About','/about/'],['contact','Contact','/contact/'],['editorialPolicy','Editorial Policy','/editorial-policy/'],['correctionsPolicy','Corrections Policy','/corrections-policy/'],['advertisingPolicy','Advertising & Disclosure','/advertising-policy/'],['privacy','Privacy Policy','/privacy/'],['terms','Terms of Use','/terms/'],['disclaimer','Disclaimer','/disclaimer/']];const esc=v=>String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function msg(t,ok=true){const e=$('msg');e.textContent=t;e.className=`msg show ${ok?'ok':'err'}`;clearTimeout(e.t);e.t=setTimeout(()=>e.classList.remove('show'),4500)}async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json'},...opt}),d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}function route(){return defs.find(x=>x[0]===current)?.[2]||'/'}function capture(){const p=pages[current]||{};pages[current]={...p,kicker:$('kicker').value,title:$('title').value,description:$('description').value,body:$('body').value,seoTitle:$('seoTitle').value,seoDescription:$('seoDescription').value,canonical:$('canonical').value,socialTitle:$('socialTitle').value,socialDescription:$('socialDescription').value,ogImage:$('ogImage').value,ogImageAlt:$('ogImageAlt').value,noindex:$('noindex').checked};dirty=false}function preview(){const p=pages[current]||{},title=$('seoTitle').value||$('title').value||'Untitled page',desc=$('seoDescription').value||$('description').value||'No meta description yet.';$('descCount').textContent=$('description').value.length;$('seoDescCount').textContent=$('seoDescription').value.length;$('previewUrl').textContent=(location.origin+route()).replace('cms.vineetkpe.workers.dev','your-site');$('previewTitle').textContent=title;$('previewDesc').textContent=desc.slice(0,160)}function fill(){const p=pages[current]||{};$('kicker').value=p.kicker||'';$('title').value=p.title||'';$('description').value=p.description||'';$('body').value=p.body||'';$('seoTitle').value=p.seoTitle||'';$('seoDescription').value=p.seoDescription||'';$('canonical').value=p.canonical||'';$('socialTitle').value=p.socialTitle||'';$('socialDescription').value=p.socialDescription||'';$('ogImage').value=p.ogImage||'';$('ogImageAlt').value=p.ogImageAlt||'';$('noindex').checked=Boolean(p.noindex);$('view').href=route();document.querySelectorAll('.page-btn').forEach(b=>b.classList.toggle('active',b.dataset.key===current));preview()}function renderList(){$('pageList').innerHTML=defs.map(([key,label,path])=>`<button class="page-btn ${key===current?'active':''}" data-key="${key}"><strong>${label}</strong><span>${path}</span></button>`).join('');document.querySelectorAll('.page-btn').forEach(b=>b.onclick=()=>{if(dirty)capture();current=b.dataset.key;fill()})}document.querySelectorAll('input,textarea').forEach(el=>el.addEventListener('input',()=>{dirty=true;preview()}));$('save').onclick=async()=>{capture();$('save').disabled=true;try{await api('/api/admin/pages',{method:'PUT',body:JSON.stringify({pages,sha})});msg('Pages saved to D1 and published immediately.');const d=await api('/api/admin/pages');pages=d.pages;sha=d.sha;fill()}catch(e){msg(e.message,false)}finally{$('save').disabled=false}};async function boot(){try{const auth=await api('/api/admin/login');if(!auth.authenticated)throw new Error();const d=await api('/api/admin/pages');pages=d.pages||{};sha=d.sha||'';renderList();fill();$('app').hidden=false}catch(e){location.replace('/admin/login/')}}boot();</script></body></html>

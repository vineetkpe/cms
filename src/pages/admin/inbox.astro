---
export const prerender = true;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Contact Inbox</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f7fa;color:#111827;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.wrap{width:min(calc(100% - 32px),1050px);margin:auto;padding:38px 0 70px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.top h1{margin:0;font-size:2rem}.back{color:#1769e0;text-decoration:none;font-weight:700}.toolbar{display:flex;gap:10px;align-items:center;margin-bottom:16px}.toolbar select{padding:9px 11px;border:1px solid #d0d5dd;border-radius:8px;background:#fff}.list{display:grid;gap:12px}.item{background:#fff;border:1px solid #e2e7ee;border-radius:13px;padding:18px}.meta{display:flex;gap:10px;flex-wrap:wrap;color:#667085;font-size:.8rem}.item h2{font-size:1.05rem;margin:10px 0 4px}.item p{white-space:pre-wrap;margin:10px 0;color:#344054;line-height:1.55}.email{font-size:.84rem}.email a{color:#1769e0}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.button{border:1px solid #d0d5dd;background:#fff;border-radius:8px;padding:8px 11px;font-weight:700;cursor:pointer}.done{background:#ecfdf3;border-color:#abefc6;color:#067647}.spam,.danger{background:#fff1f3;color:#c01048}.empty{background:#fff;border:1px solid #e2e7ee;border-radius:12px;padding:24px;color:#667085}.msg{margin-bottom:14px;padding:10px 12px;border-radius:8px;display:none}.msg.show{display:block}.ok{background:#ecfdf3;color:#027a48}.err{background:#fef3f2;color:#b42318}@media(max-width:620px){.top{align-items:flex-start;flex-direction:column}.toolbar{align-items:flex-start;flex-direction:column}}</style></head><body><main class="wrap"><div class="top"><div><div style="font-size:.8rem;color:#667085">Owner / admin</div><h1>Contact inbox</h1></div><a class="back" href="/admin/">← Control center</a></div><div id="msg" class="msg"></div><div class="toolbar"><label>Status <select id="status"><option value="new">New</option><option value="read">Read</option><option value="replied">Replied</option><option value="spam">Spam</option><option value="archived">Archived</option><option value="all">All</option></select></label><button class="button" id="refresh">Refresh</button></div><div id="list" class="list"></div></main><script is:inline>const list=document.getElementById('list'),status=document.getElementById('status'),msgEl=document.getElementById('msg');function msg(t,ok=true){msgEl.textContent=t;msgEl.className=`msg show ${ok?'ok':'err'}`;setTimeout(()=>msgEl.classList.remove('show'),3500)}async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json'},...opt}),d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}function button(label,cls,fn){const b=document.createElement('button');b.className=`button ${cls||''}`;b.textContent=label;b.onclick=fn;return b}async function setState(id,value){try{await api('/api/admin/contact',{method:'PATCH',body:JSON.stringify({id,status:value})});msg(`Message marked ${value}.`);load()}catch(e){msg(e.message,false)}}async function remove(id){if(!confirm('Delete this message permanently?'))return;try{await api(`/api/admin/contact?id=${encodeURIComponent(id)}`,{method:'DELETE'});msg('Message deleted.');load()}catch(e){msg(e.message,false)}}function render(items){list.replaceChildren();if(!items.length){const e=document.createElement('div');e.className='empty';e.textContent='No messages in this view.';list.append(e);return}items.forEach(c=>{const article=document.createElement('article');article.className='item';const meta=document.createElement('div');meta.className='meta';const name=document.createElement('strong');name.textContent=c.name||'Visitor';const time=document.createElement('span');const d=new Date(c.created_at);time.textContent=Number.isNaN(d.getTime())?'':d.toLocaleString();meta.append(name,time);const email=document.createElement('div');email.className='email';const mail=document.createElement('a');mail.href=`mailto:${c.email}`;mail.textContent=c.email||'';email.append(mail);const h=document.createElement('h2');h.textContent=c.subject||'(No subject)';const body=document.createElement('p');body.textContent=c.message||'';const actions=document.createElement('div');actions.className='actions';if(c.status!=='read')actions.append(button('Mark read','',()=>setState(c.id,'read')));if(c.status!=='replied')actions.append(button('Replied','done',()=>setState(c.id,'replied')));if(c.status!=='archived')actions.append(button('Archive','',()=>setState(c.id,'archived')));if(c.status!=='spam')actions.append(button('Spam','spam',()=>setState(c.id,'spam')));actions.append(button('Delete','danger',()=>remove(c.id)));article.append(meta,email,h,body,actions);list.append(article)})}async function load(){list.innerHTML='<div class="empty">Loading…</div>';try{const q=status.value==='all'?'':'?status='+encodeURIComponent(status.value);const d=await api('/api/admin/contact'+q);render(d.submissions||[])}catch(e){list.innerHTML='';msg(e.message,false)}}status.onchange=load;document.getElementById('refresh').onclick=load;load();</script></body></html>
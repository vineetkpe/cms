---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>CMS Admin</title>
  <style>
    :root{--bg:#f5f7fa;--panel:#fff;--text:#111827;--muted:#697386;--line:#e2e7ee;--accent:#1769e0;--danger:#b42318;--ok:#027a48}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}button,input,textarea,select{font:inherit}button{cursor:pointer}.shell{display:grid;grid-template-columns:235px minmax(0,1fr);min-height:100vh}.sidebar{background:#101828;color:#d0d5dd;padding:25px 18px;position:sticky;top:0;height:100vh}.logo{font-size:1.25rem;font-weight:850;color:#fff;margin:0 10px 28px}.nav button,.nav a{width:100%;display:block;text-align:left;border:0;background:transparent;color:#aeb7c6;padding:10px 12px;border-radius:8px;margin:2px 0;text-decoration:none}.nav button.active,.nav button:hover,.nav a:hover{background:#202939;color:#fff}.main{padding:30px;min-width:0}.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:26px}.topbar h1{margin:0;font-size:1.7rem;letter-spacing:-.03em}.status{font-size:.83rem;color:var(--muted)}.view{display:none}.view.active{display:block}.panel,.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 5px 20px rgba(16,24,40,.035)}.panel{overflow:hidden}.panel-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:12px}.panel-head h2,.card h3{font-size:1rem;margin:0}.button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 13px;font-weight:700}.button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.button.danger{color:var(--danger)}.message{display:none;padding:11px 13px;border-radius:8px;margin-bottom:16px;font-size:.9rem}.message.show{display:block}.message.ok{background:#ecfdf3;color:var(--ok)}.message.err{background:#fef3f2;color:var(--danger)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px}.stat{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px}.stat strong{font-size:1.8rem;display:block}.stat span{color:var(--muted);font-size:.82rem}.post-tools{display:flex;gap:8px;flex-wrap:wrap}.post-tools input,.post-tools select{width:auto;min-width:170px}.post-row{display:grid;grid-template-columns:minmax(0,1fr) 100px 120px 70px;gap:16px;align-items:center;padding:14px 20px;border-bottom:1px solid var(--line)}.post-row:last-child{border:0}.post-title{font-weight:750}.post-sub{font-size:.8rem;color:var(--muted)}.pill{font-size:.74rem;font-weight:750;border:1px solid var(--line);border-radius:99px;padding:4px 8px;width:max-content}.pill.draft{background:#fff7e6;color:#995c00}.pill.scheduled{background:#eef4ff;color:#3538cd}.form-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.65fr);gap:20px}.stack{display:grid;gap:16px}.field{display:grid;gap:6px}.field label{font-weight:700;font-size:.84rem}.field small{color:var(--muted)}input,textarea,select{width:100%;border:1px solid var(--line);border-radius:9px;padding:10px 11px;background:#fff;color:var(--text)}textarea{resize:vertical}.body-editor{min-height:500px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;line-height:1.6}.card{padding:17px}.actions,.toolbar{display:flex;gap:7px;flex-wrap:wrap}.toolbar{margin-bottom:7px}.toolbar button{border:1px solid var(--line);background:#fff;border-radius:6px;padding:5px 8px}.settings-form{max-width:880px;padding:20px}.media-preview{margin-top:10px;max-width:100%;max-height:180px;border-radius:8px}.check{display:flex;gap:8px;align-items:center}.check input{width:auto}.empty{padding:28px;color:var(--muted)}.redirect-row{display:grid;grid-template-columns:1fr 1fr 100px 80px;gap:10px;padding:12px 20px;border-bottom:1px solid var(--line);align-items:center}.faq-row{display:grid;grid-template-columns:1fr 1.4fr 40px;gap:8px;margin-top:8px}.divider{height:1px;background:var(--line);margin:5px 0}.muted{color:var(--muted);font-size:.82rem}@media(max-width:900px){.shell{grid-template-columns:1fr}.sidebar{position:static;height:auto;padding:14px}.logo{margin:0 8px 10px}.nav{display:flex;overflow-x:auto}.nav button,.nav a{white-space:nowrap;width:auto}.main{padding:18px}.form-grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.post-row{grid-template-columns:1fr 90px}.post-row>:nth-child(3),.post-row>:nth-child(4){display:none}.redirect-row{grid-template-columns:1fr}.faq-row{grid-template-columns:1fr}}
  </style>
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="logo">CMS Admin</div>
    <div class="nav">
      <button data-view="dashboard" class="active">Dashboard</button>
      <button data-view="posts">Posts</button>
      <button data-view="editor">New article</button>
      <button data-view="redirects">Redirects</button>
      <button data-view="settings">Site settings</button>
      <a href="/" target="_blank">View website ↗</a>
    </div>
  </aside>
  <main class="main">
    <div id="message" class="message"></div>

    <section id="dashboard" class="view active">
      <div class="topbar"><div><h1>Dashboard</h1><div class="status" id="adminStatus">Connecting to admin API…</div></div><button class="button primary" id="dashNew">New article</button></div>
      <div class="stats"><div class="stat"><strong id="statPublished">0</strong><span>Published</span></div><div class="stat"><strong id="statDrafts">0</strong><span>Private drafts</span></div><div class="stat"><strong id="statScheduled">0</strong><span>Scheduled</span></div><div class="stat"><strong id="statCategories">0</strong><span>Categories</span></div></div>
      <div class="panel"><div class="panel-head"><h2>Recent articles</h2><button class="button" data-view="posts">Manage posts</button></div><div id="recentList"><div class="empty">Loading…</div></div></div>
    </section>

    <section id="posts" class="view">
      <div class="topbar"><div><h1>Posts</h1><div class="status">Published, scheduled and encrypted drafts.</div></div><button class="button primary" id="newPost">New article</button></div>
      <div class="panel"><div class="panel-head"><h2>All articles</h2><div class="post-tools"><input id="postSearch" placeholder="Search posts…" /><select id="postFilter"><option value="all">All status</option><option value="published">Published</option><option value="draft">Draft</option><option value="scheduled">Scheduled</option></select><button class="button" id="refreshPosts">Refresh</button></div></div><div id="postList"><div class="empty">Loading…</div></div></div>
    </section>

    <section id="editor" class="view">
      <div class="topbar"><div><h1 id="editorTitle">New article</h1><div class="status">Markdown editor · drafts are encrypted · publish creates a Git commit.</div></div><button class="button" data-view="posts">← Back</button></div>
      <form id="postForm" class="form-grid">
        <div class="stack">
          <div class="card stack"><div class="field"><label>Title</label><input id="title" maxlength="180" required /></div><div class="field"><label>Slug</label><input id="slug" pattern="[a-z0-9-]+" required /><small>Permanent URL. Avoid changing after indexing.</small></div><div class="field"><label>Description / deck</label><textarea id="description" rows="3" maxlength="320" required></textarea></div></div>
          <div class="card"><div class="field"><label>Article</label><div class="toolbar"><button type="button" data-md="## ">H2</button><button type="button" data-md="### ">H3</button><button type="button" data-wrap="**">Bold</button><button type="button" data-wrap="_">Italic</button><button type="button" data-md="- ">List</button><button type="button" data-md="> ">Quote</button><button type="button" data-link>Link</button></div><textarea id="body" class="body-editor" required placeholder="Write in Markdown…"></textarea></div></div>
          <div class="card stack"><div><h3>FAQs</h3><div class="muted">Optional. FAQs are displayed on the article and included in structured data.</div></div><div id="faqList"></div><div><button type="button" class="button" id="addFaq">+ Add FAQ</button></div></div>
        </div>
        <aside class="stack">
          <div class="card stack"><h3>Publishing</h3><div class="field"><label>Category</label><input id="category" value="Guides" /></div><div class="field"><label>Tags</label><input id="tags" placeholder="seo, guides, news" /></div><div class="field"><label>Author</label><input id="author" value="Editorial Team" /></div><div class="field"><label>Publish date</label><input id="pubDate" type="date" /><small>Future dates remain hidden until a scheduled rebuild after this date.</small></div><label class="check"><input id="featured" type="checkbox" /> Feature on homepage</label><label class="check"><input id="hideAds" type="checkbox" /> Hide ads on this article</label><label class="check"><input id="noindex" type="checkbox" /> Noindex this article</label><div class="actions"><button type="button" class="button" id="saveDraft">Save draft</button><button type="button" class="button" id="previewPost">Preview</button><button type="button" class="button primary" id="publish">Publish</button><button type="button" class="button danger" id="deletePost" hidden>Delete</button></div></div>
          <div class="card stack"><h3>Featured image</h3><input id="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/avif" /><button type="button" class="button" id="uploadImage">Optimize & upload</button><input id="featuredImage" placeholder="/uploads/... or https://..." /><div class="field"><label>Image alt text</label><input id="featuredImageAlt" maxlength="180" /></div><img id="mediaPreview" class="media-preview" hidden alt="" /></div>
          <div class="card stack"><h3>SEO</h3><div class="field"><label>SEO title</label><input id="seoTitle" maxlength="180" /><small id="seoTitleCount">0 characters</small></div><div class="field"><label>Meta description</label><textarea id="seoDescription" rows="3" maxlength="320"></textarea><small id="seoDescCount">0 characters</small></div><div class="field"><label>Canonical URL</label><input id="canonical" type="url" placeholder="Optional" /></div></div>
        </aside>
      </form>
    </section>

    <section id="redirects" class="view">
      <div class="topbar"><div><h1>Redirects</h1><div class="status">SEO-safe static redirects compiled into Cloudflare's _redirects file.</div></div><div class="actions"><button class="button" id="addRedirect">+ Add</button><button class="button primary" id="saveRedirects">Save redirects</button></div></div>
      <div class="panel"><div class="panel-head"><h2>Redirect rules</h2><span class="muted">Use 301 for permanent URL changes.</span></div><div id="redirectList"><div class="empty">Loading…</div></div></div>
    </section>

    <section id="settings" class="view">
      <div class="topbar"><div><h1>Site settings</h1><div class="status">Global branding, SEO, analytics, ads and navigation.</div></div></div>
      <div class="panel"><form id="settingsForm" class="settings-form stack">
        <div class="field"><label>Site name</label><input id="siteName" required /></div><div class="field"><label>Logo text</label><input id="logoText" required /></div><div class="field"><label>Tagline</label><input id="tagline" required /></div><div class="field"><label>Description</label><textarea id="siteDescription" rows="3" required></textarea></div><div class="field"><label>Production URL</label><input id="siteUrl" type="url" required /></div><div class="field"><label>Contact email</label><input id="siteEmail" type="email" /></div><div class="field"><label>Default author</label><input id="siteAuthor" /></div><div class="field"><label>Language code</label><input id="siteLanguage" placeholder="en" /></div><div class="field"><label>Primary color</label><input id="primaryColor" type="color" /></div><div class="field"><label>Default social/OG image</label><input id="defaultOgImage" placeholder="/uploads/default-og.webp" /></div><div class="field"><label>Footer text</label><textarea id="footerText" rows="2"></textarea></div>
        <div class="divider"></div><h3>Google & monetization</h3><div class="field"><label>Google Analytics measurement ID</label><input id="googleAnalyticsId" placeholder="G-XXXXXXXXXX" /></div><div class="field"><label>Google Search Console verification</label><input id="googleSiteVerification" /></div><div class="field"><label>AdSense publisher ID</label><input id="adsensePublisherId" placeholder="ca-pub-1234567890" /><small>Leave blank until approved. ads.txt is generated automatically.</small></div><div class="field"><label>Article ad slot ID</label><input id="adsenseArticleSlot" inputmode="numeric" /></div><div class="field"><label>Sidebar ad slot ID</label><input id="adsenseSidebarSlot" inputmode="numeric" /></div>
        <div class="divider"></div><h3>Social links</h3><div class="field"><label>X / Twitter</label><input id="socialX" type="url" /></div><div class="field"><label>LinkedIn</label><input id="socialLinkedin" type="url" /></div><div class="field"><label>Instagram</label><input id="socialInstagram" type="url" /></div><div class="field"><label>YouTube</label><input id="socialYoutube" type="url" /></div>
        <div class="divider"></div><div class="field"><label>Navigation (one per line: Label | /url/)</label><textarea id="navigation" rows="7"></textarea></div><div><button class="button primary" type="submit">Save settings</button></div>
      </form></div>
    </section>
  </main>
</div>
<script is:inline>
  const $=id=>document.getElementById(id);let posts=[],current=null,settingsSha='',redirectSha='',redirects=[],settings=null;
  const today=()=>new Date().toISOString().slice(0,10);
  function message(text,ok=true){const el=$('message');el.textContent=text;el.className=`message show ${ok?'ok':'err'}`;window.scrollTo({top:0,behavior:'smooth'});setTimeout(()=>el.classList.remove('show'),5000)}
  function showView(name){document.querySelectorAll('.view').forEach(el=>el.classList.toggle('active',el.id===name));document.querySelectorAll('[data-view]').forEach(el=>el.classList.toggle('active',el.getAttribute('data-view')===name));if(name==='settings')loadSettings();if(name==='redirects')loadRedirects()}
  document.addEventListener('click',e=>{const target=e.target.closest('[data-view]');if(target)showView(target.getAttribute('data-view'))});
  function slugify(v){return String(v||'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,90)}
  function statusOf(post){if(post.draft)return'draft';if(post.pubDate>today())return'scheduled';return'published'}
  async function api(url,options={}){const r=await fetch(url,{headers:{'Content-Type':'application/json',...(options.headers||{})},...options});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||`Request failed (${r.status})`);return data}
  function renderPostRows(target,list){if(!list.length){target.innerHTML='<div class="empty">No matching articles.</div>';return}target.replaceChildren(...list.map(post=>{const row=document.createElement('div');row.className='post-row';const info=document.createElement('div');const t=document.createElement('div');t.className='post-title';t.textContent=post.title;const sub=document.createElement('div');sub.className='post-sub';sub.textContent=`/${post.slug}/ · ${post.category}`;info.append(t,sub);const s=statusOf(post),pill=document.createElement('span');pill.className=`pill ${s==='draft'?'draft':s==='scheduled'?'scheduled':''}`;pill.textContent=s[0].toUpperCase()+s.slice(1);const date=document.createElement('div');date.className='post-sub';date.textContent=post.pubDate;const edit=document.createElement('button');edit.className='button';edit.textContent='Edit';edit.onclick=()=>editPost(post);row.append(info,pill,date,edit);return row}))}
  function renderStats(){const statuses=posts.map(statusOf);$('statPublished').textContent=statuses.filter(v=>v==='published').length;$('statDrafts').textContent=statuses.filter(v=>v==='draft').length;$('statScheduled').textContent=statuses.filter(v=>v==='scheduled').length;$('statCategories').textContent=new Set(posts.map(p=>p.category)).size;renderPostRows($('recentList'),posts.slice(0,5))}
  function applyPostFilter(){const q=$('postSearch').value.trim().toLowerCase(),filter=$('postFilter').value;const list=posts.filter(p=>(filter==='all'||statusOf(p)===filter)&&(!q||`${p.title} ${p.slug} ${p.category} ${(p.tags||[]).join(' ')}`.toLowerCase().includes(q)));renderPostRows($('postList'),list)}
  async function loadPosts(){try{const data=await api('/api/admin/posts');posts=data.posts||[];$('adminStatus').textContent=`Authenticated as ${data.admin} · ${posts.length} articles`;renderStats();applyPostFilter()}catch(e){$('postList').innerHTML=`<div class="empty">${e.message}</div>`;$('recentList').innerHTML=`<div class="empty">${e.message}</div>`;$('adminStatus').textContent='Admin API is not configured yet.'}}
  $('postSearch').addEventListener('input',applyPostFilter);$('postFilter').addEventListener('change',applyPostFilter);$('refreshPosts').onclick=loadPosts;
  function resetForm(){current=null;$('postForm').reset();$('category').value='Guides';$('author').value=settings?.author||'Editorial Team';$('pubDate').value=today();$('editorTitle').textContent='New article';$('deletePost').hidden=true;$('mediaPreview').hidden=true;$('faqList').innerHTML='';$('seoTitleCount').textContent='0 characters';$('seoDescCount').textContent='0 characters'}
  function addFaqRow(item={question:'',answer:''}){const row=document.createElement('div');row.className='faq-row';const q=document.createElement('input');q.placeholder='Question';q.value=item.question||'';q.dataset.faq='question';const a=document.createElement('textarea');a.rows=2;a.placeholder='Answer';a.value=item.answer||'';a.dataset.faq='answer';const remove=document.createElement('button');remove.type='button';remove.className='button danger';remove.textContent='×';remove.onclick=()=>row.remove();row.append(q,a,remove);$('faqList').append(row)}
  $('addFaq').onclick=()=>addFaqRow();
  function editPost(post){current={...post,originalSlug:post.slug};$('editorTitle').textContent='Edit article';['title','slug','description','category','author','pubDate','featuredImage','featuredImageAlt','seoTitle','seoDescription','canonical','body'].forEach(id=>$(id).value=post[id]||'');$('tags').value=(post.tags||[]).join(', ');$('noindex').checked=!!post.noindex;$('featured').checked=!!post.featured;$('hideAds').checked=!!post.hideAds;$('deletePost').hidden=false;$('faqList').innerHTML='';(post.faq||[]).forEach(addFaqRow);if(post.featuredImage){$('mediaPreview').src=post.featuredImage;$('mediaPreview').hidden=false}showView('editor');updateCounts()}
  function faqData(){return[...document.querySelectorAll('.faq-row')].map(row=>({question:row.querySelector('[data-faq="question"]').value.trim(),answer:row.querySelector('[data-faq="answer"]').value.trim()})).filter(i=>i.question&&i.answer)}
  function formData(draft){const editingPublished=current&&!current.draft;return{slug:$('slug').value,originalSlug:current?.originalSlug,title:$('title').value,description:$('description').value,category:$('category').value,tags:$('tags').value.split(',').map(v=>v.trim()).filter(Boolean),author:$('author').value,pubDate:$('pubDate').value,updatedDate:!draft&&editingPublished?today():current?.updatedDate,featuredImage:$('featuredImage').value,featuredImageAlt:$('featuredImageAlt').value,seoTitle:$('seoTitle').value,seoDescription:$('seoDescription').value,canonical:$('canonical').value,draft,noindex:$('noindex').checked,featured:$('featured').checked,hideAds:$('hideAds').checked,faq:faqData(),body:$('body').value,sha:current?.sha}}
  async function save(draft){try{const data=await api('/api/admin/posts',{method:'POST',body:JSON.stringify(formData(draft))});message(draft?'Private encrypted draft saved.':($('pubDate').value>today()?'Scheduled article saved. It will appear after its publish date and the next scheduled build.':'Published. The next deployment will include this article.'));await loadPosts();const saved=posts.find(p=>p.slug===data.slug);if(saved)editPost(saved)}catch(e){message(e.message,false)}}
  $('saveDraft').onclick=()=>save(true);$('publish').onclick=()=>save(false);$('previewPost').onclick=()=>{localStorage.setItem('cms-preview',JSON.stringify(formData(false)));window.open('/admin/preview/','_blank','noopener')};
  $('deletePost').onclick=async()=>{if(!current||!confirm(`Delete “${current.title}”? This cannot be undone from the CMS.`))return;try{await api('/api/admin/posts',{method:'DELETE',body:JSON.stringify({slug:current.slug})});message('Article deleted.');await loadPosts();showView('posts')}catch(e){message(e.message,false)}};
  $('newPost').onclick=$('dashNew').onclick=()=>{resetForm();showView('editor')};
  $('title').addEventListener('input',()=>{if(!current)$('slug').value=slugify($('title').value)});function updateCounts(){$('seoTitleCount').textContent=`${$('seoTitle').value.length} characters`;$('seoDescCount').textContent=`${$('seoDescription').value.length} characters`}$('seoTitle').oninput=updateCounts;$('seoDescription').oninput=updateCounts;
  document.querySelectorAll('[data-md]').forEach(btn=>btn.onclick=()=>{const el=$('body'),s=el.selectionStart,e=el.selectionEnd,p=btn.dataset.md;el.setRangeText(p+el.value.slice(s,e),s,e,'end');el.focus()});document.querySelectorAll('[data-wrap]').forEach(btn=>btn.onclick=()=>{const el=$('body'),s=el.selectionStart,e=el.selectionEnd,w=btn.dataset.wrap;el.setRangeText(w+el.value.slice(s,e)+w,s,e,'select');el.focus()});document.querySelector('[data-link]').onclick=()=>{const el=$('body'),s=el.selectionStart,e=el.selectionEnd,text=el.value.slice(s,e)||'link text';el.setRangeText(`[${text}](https://example.com)`,s,e,'select');el.focus()};
  async function optimizeImage(file){if(file.size>12*1024*1024)throw new Error('Image must be under 12 MB.');const bitmap=await createImageBitmap(file),max=1600,scale=Math.min(1,max/bitmap.width),canvas=document.createElement('canvas');canvas.width=Math.round(bitmap.width*scale);canvas.height=Math.round(bitmap.height*scale);canvas.getContext('2d').drawImage(bitmap,0,0,canvas.width,canvas.height);return new Promise((resolve,reject)=>canvas.toBlob(blob=>blob?resolve(blob):reject(new Error('Image conversion failed.')),'image/webp',.82))}
  $('uploadImage').onclick=async()=>{const file=$('imageFile').files?.[0];if(!file)return message('Choose an image first.',false);try{const blob=await optimizeImage(file),base64=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result).split(',')[1]);r.onerror=reject;r.readAsDataURL(blob)}),name=`${slugify($('slug').value||$('title').value)||'image'}-${Date.now()}.webp`,data=await api('/api/admin/media',{method:'POST',body:JSON.stringify({name,type:'image/webp',base64})});$('featuredImage').value=data.url;$('mediaPreview').src=data.url;$('mediaPreview').hidden=false;message('Image optimized and uploaded.')}catch(e){message(e.message,false)}};
  async function loadSettings(){if(settingsSha)return;try{const data=await api('/api/admin/settings');settings=data.settings;settingsSha=data.sha;const s=settings;const map={siteName:s.name,logoText:s.logoText,tagline:s.tagline,siteDescription:s.description,siteUrl:s.url,siteEmail:s.email,siteAuthor:s.author,siteLanguage:s.language,primaryColor:s.primaryColor,defaultOgImage:s.defaultOgImage,footerText:s.footerText,googleAnalyticsId:s.googleAnalyticsId,googleSiteVerification:s.googleSiteVerification,adsensePublisherId:s.adsensePublisherId,adsenseArticleSlot:s.adsenseArticleSlot,adsenseSidebarSlot:s.adsenseSidebarSlot,socialX:s.social?.x,socialLinkedin:s.social?.linkedin,socialInstagram:s.social?.instagram,socialYoutube:s.social?.youtube};Object.entries(map).forEach(([id,v])=>$(id).value=v||'');$('navigation').value=(s.navigation||[]).map(i=>`${i.label} | ${i.href}`).join('\n')}catch(e){message(e.message,false)}}
  $('settingsForm').onsubmit=async e=>{e.preventDefault();try{const nav=$('navigation').value.split('\n').map(line=>{const [label,...rest]=line.split('|');return{label:(label||'').trim(),href:rest.join('|').trim()}}).filter(i=>i.label&&i.href);const settingsOut={name:$('siteName').value,logoText:$('logoText').value,tagline:$('tagline').value,description:$('siteDescription').value,url:$('siteUrl').value,email:$('siteEmail').value,author:$('siteAuthor').value,language:$('siteLanguage').value,primaryColor:$('primaryColor').value,defaultOgImage:$('defaultOgImage').value,footerText:$('footerText').value,googleAnalyticsId:$('googleAnalyticsId').value,googleSiteVerification:$('googleSiteVerification').value,adsensePublisherId:$('adsensePublisherId').value,adsenseArticleSlot:$('adsenseArticleSlot').value,adsenseSidebarSlot:$('adsenseSidebarSlot').value,social:{x:$('socialX').value,linkedin:$('socialLinkedin').value,instagram:$('socialInstagram').value,youtube:$('socialYoutube').value},navigation:nav};const data=await api('/api/admin/settings',{method:'PUT',body:JSON.stringify({settings:settingsOut,sha:settingsSha})});settingsSha=data.sha||settingsSha;settings=settingsOut;message('Site settings saved. A new build will apply the changes.')}catch(err){message(err.message,false)}};
  function redirectRow(item={from:'',to:'',status:301}){const row=document.createElement('div');row.className='redirect-row';const from=document.createElement('input');from.placeholder='/old-url/';from.value=item.from||'';from.dataset.redirect='from';const to=document.createElement('input');to.placeholder='/new-url/';to.value=item.to||'';to.dataset.redirect='to';const status=document.createElement('select');status.dataset.redirect='status';[301,302,303,307,308].forEach(code=>{const o=document.createElement('option');o.value=code;o.textContent=code;if(Number(item.status)===code)o.selected=true;status.append(o)});const del=document.createElement('button');del.className='button danger';del.textContent='Remove';del.onclick=()=>row.remove();row.append(from,to,status,del);return row}
  async function loadRedirects(){if(redirectSha)return;try{const data=await api('/api/admin/redirects');redirects=data.redirects||[];redirectSha=data.sha;renderRedirects()}catch(e){message(e.message,false)}}function renderRedirects(){const root=$('redirectList');root.innerHTML='';if(!redirects.length)root.innerHTML='<div class="empty">No redirects yet.</div>';else redirects.forEach(item=>root.append(redirectRow(item)))}$('addRedirect').onclick=()=>{if($('redirectList').querySelector('.empty'))$('redirectList').innerHTML='';$('redirectList').append(redirectRow())};$('saveRedirects').onclick=async()=>{try{const list=[...$('redirectList').querySelectorAll('.redirect-row')].map(row=>({from:row.querySelector('[data-redirect="from"]').value.trim(),to:row.querySelector('[data-redirect="to"]').value.trim(),status:Number(row.querySelector('[data-redirect="status"]').value)})).filter(i=>i.from||i.to);const data=await api('/api/admin/redirects',{method:'PUT',body:JSON.stringify({redirects:list,sha:redirectSha})});redirectSha=data.sha||redirectSha;redirects=list;message('Redirects saved. The next build will compile them.')}catch(e){message(e.message,false)}};
  loadSettings().finally(()=>{resetForm();loadPosts()});
</script>
</body>
</html>

---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Posts · CMS</title>
  <style>
    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:#f5f7fb;color:#172033}.main{padding:28px 30px 70px}.top{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:20px}.top h1{margin:0;font-size:1.75rem}.top p{margin:5px 0 0;color:#7a8494;font-size:.84rem}.actions{display:flex;gap:8px;flex-wrap:wrap}.button{border:1px solid #dfe3ea;background:#fff;border-radius:10px;padding:9px 13px;text-decoration:none;color:#475467;font-weight:750;cursor:pointer}.button.primary{background:#6d3df5;border-color:#6d3df5;color:#fff}.tabs{display:flex;gap:6px;margin-bottom:15px}.tab{border:1px solid #e3e7ee;background:#fff;color:#667085;padding:8px 11px;border-radius:9px;font-weight:760;font-size:.8rem;cursor:pointer}.tab.active{background:#f1ecff;color:#6032dc;border-color:#d9cdff}.view{display:none}.view.active{display:block}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}.stat{background:#fff;border:1px solid #e7eaf0;border-radius:15px;padding:16px;box-shadow:0 8px 24px rgba(16,24,40,.04)}.stat span{display:block;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;color:#98a2b3;font-weight:800}.stat strong{display:block;font-size:1.75rem;margin-top:5px;letter-spacing:-.05em}.panel{background:#fff;border:1px solid #e7eaf0;border-radius:16px;box-shadow:0 10px 30px rgba(16,24,40,.045);overflow:hidden}.panel-head{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:15px 17px;border-bottom:1px solid #eef0f3}.tools{display:flex;gap:7px;flex-wrap:wrap}.tools input,.tools select{border:1px solid #dfe3ea;border-radius:9px;padding:8px 10px;font:inherit;font-size:.8rem}.post-table{width:100%;border-collapse:collapse}.post-table th{padding:10px 14px;text-align:left;font-size:.66rem;text-transform:uppercase;letter-spacing:.06em;color:#98a2b3;border-bottom:1px solid #edf0f3}.post-table td{padding:13px 14px;border-bottom:1px solid #f0f2f5;vertical-align:middle;font-size:.8rem}.post-table tr:last-child td{border-bottom:0}.title{font-weight:800;color:#1d2939}.sub{font-size:.72rem;color:#98a2b3;margin-top:3px}.pill{display:inline-flex;padding:4px 7px;border-radius:999px;font-size:.68rem;font-weight:800}.published{background:#ecfdf3;color:#027a48}.draft{background:#fff4e5;color:#b54708}.scheduled{background:#eef4ff;color:#3538cd}.row-actions{display:flex;gap:6px;justify-content:flex-end}.mini{border:1px solid #e1e5eb;background:#fff;border-radius:8px;padding:6px 8px;color:#475467;text-decoration:none;cursor:pointer;font-size:.72rem;font-weight:720}.mini.danger{color:#b42318}.empty{padding:34px;color:#98a2b3;text-align:center}.notice{display:none;margin-bottom:12px;padding:10px 12px;border-radius:10px;font-size:.8rem}.notice.show{display:block}.notice.ok{background:#ecfdf3;color:#027a48}.notice.err{background:#fef3f2;color:#b42318}.redirect-list{display:grid}.redirect-row{display:grid;grid-template-columns:1fr 1fr 110px 44px;gap:8px;padding:11px 14px;border-bottom:1px solid #f0f2f5}.redirect-row input,.redirect-row select{border:1px solid #dfe3ea;border-radius:9px;padding:9px 10px;font:inherit}.redirect-row:last-child{border-bottom:0}.help{padding:14px 16px;color:#667085;font-size:.78rem;background:#fbfcfe;border-top:1px solid #eef0f3}@media(max-width:900px){.stats{grid-template-columns:repeat(2,1fr)}.post-table th:nth-child(3),.post-table td:nth-child(3),.post-table th:nth-child(4),.post-table td:nth-child(4){display:none}.redirect-row{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.stats{grid-template-columns:1fr}.post-table th:nth-child(2),.post-table td:nth-child(2){display:none}.row-actions{justify-content:flex-start;flex-wrap:wrap}}
  </style>
</head>
<body>
<main class="main" id="app" hidden>
  <div id="notice" class="notice"></div>
  <div class="top">
    <div><div class="cms-page-kicker">Content workspace</div><h1>Posts & redirects</h1><p>Manage drafts, scheduled publishing, live articles and URL changes from one place.</p></div>
    <div class="actions"><a class="button" href="/articles/" target="_blank">View archive ↗</a><a class="button primary" href="/admin/editor/">+ New article</a></div>
  </div>

  <div class="tabs"><button class="tab active" data-tab="posts">Posts</button><button class="tab" data-tab="redirects">Redirects</button></div>

  <section id="postsView" class="view active">
    <div class="stats">
      <div class="stat"><span>Published</span><strong id="sPublished">0</strong></div>
      <div class="stat"><span>Drafts</span><strong id="sDrafts">0</strong></div>
      <div class="stat"><span>Scheduled</span><strong id="sScheduled">0</strong></div>
      <div class="stat"><span>30-day views</span><strong id="sViews">0</strong></div>
    </div>
    <div class="panel">
      <div class="panel-head"><strong>All articles</strong><div class="tools"><input id="search" placeholder="Search title, slug, tag…"><select id="status"><option value="all">All status</option><option value="published">Published</option><option value="draft">Draft</option><option value="scheduled">Scheduled</option></select><select id="category"><option value="all">All categories</option></select><button class="button" id="refresh">Refresh</button></div></div>
      <div style="overflow:auto"><table class="post-table"><thead><tr><th>Article</th><th>Status</th><th>Category</th><th>Publish time</th><th>Views · 30d</th><th></th></tr></thead><tbody id="postRows"><tr><td colspan="6" class="empty">Loading articles…</td></tr></tbody></table></div>
    </div>
  </section>

  <section id="redirectsView" class="view">
    <div class="panel">
      <div class="panel-head"><div><strong>SEO redirects</strong><div class="sub">Use 301 for permanent URL changes. Redirects are versioned in Git.</div></div><div class="actions"><button class="button" id="addRedirect">+ Add redirect</button><button class="button primary" id="saveRedirects">Save redirects</button></div></div>
      <div class="redirect-list" id="redirectList"><div class="empty">Loading redirects…</div></div>
      <div class="help">Source must start with <strong>/</strong>. Destination can be a site path or full URL. Duplicate source paths are rejected.</div>
    </div>
  </section>
</main>
<script is:inline>
  const $=id=>document.getElementById(id);let posts=[],views=new Map(),redirects=[],redirectSha='';
  const fmt=n=>new Intl.NumberFormat().format(Number(n||0));
  const esc=v=>String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json',...(opt.headers||{})},...opt});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||`Request failed (${r.status})`);return d}
  function notice(text,ok=true){const el=$('notice');el.textContent=text;el.className=`notice show ${ok?'ok':'err'}`;clearTimeout(el.t);el.t=setTimeout(()=>el.classList.remove('show'),4500)}
  function postStatus(p){if(p.draft)return'draft';const t=Date.parse(p.publishAt||`${p.pubDate||''}T00:00:00Z`);return Number.isFinite(t)&&t>Date.now()?'scheduled':'published'}
  function setTab(name){document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===name));$('postsView').classList.toggle('active',name==='posts');$('redirectsView').classList.toggle('active',name==='redirects');history.replaceState({},'',name==='redirects'?'#redirects':location.pathname)}
  document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>setTab(b.dataset.tab));
  function categories(){return [...new Set(posts.map(p=>p.category).filter(Boolean))].sort()}
  function fillCategories(){const current=$('category').value;$('category').innerHTML='<option value="all">All categories</option>'+categories().map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');if([...$('category').options].some(o=>o.value===current))$('category').value=current}
  function renderStats(analytics={}){const counts={published:0,draft:0,scheduled:0};posts.forEach(p=>counts[postStatus(p)]++);$('sPublished').textContent=fmt(counts.published);$('sDrafts').textContent=fmt(counts.draft);$('sScheduled').textContent=fmt(counts.scheduled);$('sViews').textContent=fmt(analytics.views?.last30Days)}
  function renderPosts(){const q=$('search').value.trim().toLowerCase(),st=$('status').value,cat=$('category').value;const filtered=posts.filter(p=>{const ps=postStatus(p);const hay=`${p.title} ${p.slug} ${p.category} ${(p.tags||[]).join(' ')}`.toLowerCase();return(!q||hay.includes(q))&&(st==='all'||ps===st)&&(cat==='all'||p.category===cat)});const root=$('postRows');if(!filtered.length){root.innerHTML='<tr><td colspan="6" class="empty">No matching articles.</td></tr>';return}root.innerHTML=filtered.map(p=>{const ps=postStatus(p);const date=p.publishAt||p.pubDate;const view=views.get(p.slug)||0;const viewBtn=ps==='published'?`<a class="mini" href="/${encodeURIComponent(p.slug)}/" target="_blank">View</a>`:'';return`<tr><td><div class="title">${esc(p.title)}</div><div class="sub">/${esc(p.slug)}/ · ${esc((p.tags||[]).slice(0,3).join(', '))}</div></td><td><span class="pill ${ps}">${ps}</span></td><td>${esc(p.category||'—')}</td><td>${date?new Date(date).toLocaleString(): '—'}</td><td><strong>${fmt(view)}</strong></td><td><div class="row-actions"><a class="mini" href="/admin/editor/?slug=${encodeURIComponent(p.slug)}">Edit</a>${viewBtn}<button class="mini danger" data-delete="${esc(p.slug)}">Delete</button></div></td></tr>`}).join('');root.querySelectorAll('[data-delete]').forEach(btn=>btn.onclick=async()=>{const slug=btn.dataset.delete,p=posts.find(x=>x.slug===slug);if(!confirm(`Delete “${p?.title||slug}”? Published revisions remain recoverable in Git history.`))return;try{await api('/api/admin/posts',{method:'DELETE',body:JSON.stringify({slug})});notice('Article deleted.');await load()}catch(e){notice(e.message,false)}})}
  ['search','status','category'].forEach(id=>$(id).addEventListener(id==='search'?'input':'change',renderPosts));$('refresh').onclick=()=>load(true);
  async function load(show=false){try{const [p,a]=await Promise.all([api('/api/admin/posts'),api('/api/admin/analytics').catch(()=>({views:{},topPosts:[]}))]);posts=p.posts||[];views=new Map((a.topPosts||[]).map(x=>[x.slug,Number(x.views||0)]));fillCategories();renderStats(a);renderPosts();if(show)notice('Posts refreshed.')}catch(e){notice(e.message,false);$('postRows').innerHTML=`<tr><td colspan="6" class="empty">${esc(e.message)}</td></tr>`}}
  function redirectRow(item={from:'',to:'',status:301}){const row=document.createElement('div');row.className='redirect-row';row.innerHTML=`<input data-k="from" placeholder="/old-url/" value="${esc(item.from)}"><input data-k="to" placeholder="/new-url/ or https://…" value="${esc(item.to)}"><select data-k="status">${[301,302,303,307,308].map(s=>`<option value="${s}" ${Number(item.status)===s?'selected':''}>${s}</option>`).join('')}</select><button class="mini danger" type="button">×</button>`;row.querySelector('button').onclick=()=>row.remove();return row}
  function renderRedirects(){const root=$('redirectList');root.innerHTML='';if(!redirects.length)root.innerHTML='<div class="empty">No redirects yet. Add one when a URL changes.</div>';else redirects.forEach(r=>root.append(redirectRow(r)))}
  function collectRedirects(){return[...$('redirectList').querySelectorAll('.redirect-row')].map(r=>({from:r.querySelector('[data-k=from]').value.trim(),to:r.querySelector('[data-k=to]').value.trim(),status:Number(r.querySelector('[data-k=status]').value)})).filter(r=>r.from||r.to)}
  async function loadRedirects(){try{const d=await api('/api/admin/redirects');redirects=d.redirects||[];redirectSha=d.sha||'';renderRedirects()}catch(e){$('redirectList').innerHTML=`<div class="empty">${esc(e.message)}</div>`}}
  $('addRedirect').onclick=()=>{if(!$('redirectList').querySelector('.redirect-row'))$('redirectList').innerHTML='';$('redirectList').append(redirectRow())};$('saveRedirects').onclick=async()=>{try{await api('/api/admin/redirects',{method:'PUT',body:JSON.stringify({redirects:collectRedirects(),sha:redirectSha})});notice('Redirects saved.');await loadRedirects()}catch(e){notice(e.message,false)}};
  async function boot(){try{const auth=await api('/api/admin/login');if(!auth.authenticated)throw new Error('Not signed in');$('app').hidden=false;await Promise.all([load(),loadRedirects()]);if(location.hash==='#redirects')setTab('redirects')}catch{location.replace('/admin/login/')}}boot();
</script>
</body>
</html>

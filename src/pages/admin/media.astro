---
export const prerender = true;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Media Library</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f7fa;color:#111827;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.wrap{width:min(calc(100% - 32px),1100px);margin:0 auto;padding:38px 0 70px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.top h1{margin:0;font-size:2rem}.back{color:#1769e0;text-decoration:none;font-weight:700}.upload{display:flex;gap:9px;flex-wrap:wrap;background:#fff;border:1px solid #e2e7ee;border-radius:13px;padding:16px;margin-bottom:22px}.button{border:1px solid #d0d5dd;background:#fff;border-radius:8px;padding:9px 13px;font-weight:750;cursor:pointer}.primary{background:#1769e0;color:#fff;border-color:#1769e0}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.card{background:#fff;border:1px solid #e2e7ee;border-radius:12px;overflow:hidden}.card img{width:100%;aspect-ratio:16/10;object-fit:cover;background:#eef1f5}.meta{padding:10px}.name{font-size:.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:8px}.actions{display:flex;gap:6px}.actions button{font-size:.75rem;padding:6px 8px}.msg{margin-bottom:14px;padding:10px 12px;border-radius:8px;display:none}.msg.show{display:block}.ok{background:#ecfdf3;color:#027a48}.err{background:#fef3f2;color:#b42318}.empty{padding:35px;background:#fff;border:1px solid #e2e7ee;border-radius:12px;color:#667085}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.grid{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}}</style></head><body><main class="wrap"><div class="top"><div><div style="font-size:.8rem;color:#667085">CMS</div><h1>Media library</h1></div><a class="back" href="/admin/">← Control center</a></div><div id="msg" class="msg"></div><div class="upload"><input id="file" type="file" accept="image/jpeg,image/png,image/webp,image/avif"><button id="upload" class="button primary">Optimize & upload</button><button id="refresh" class="button">Refresh</button></div><div id="grid" class="grid"></div></main><script is:inline>const $=id=>document.getElementById(id);let media=[];function msg(t,ok=true){const e=$('msg');e.textContent=t;e.className=`msg show ${ok?'ok':'err'}`;setTimeout(()=>e.classList.remove('show'),4500)}async function api(url,opt={}){const r=await fetch(url,{headers:{'Content-Type':'application/json'},...opt}),d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}function render(){const root=$('grid');root.innerHTML='';if(!media.length){root.innerHTML='<div class="empty">No uploaded media yet.</div>';return}media.forEach(item=>{const c=document.createElement('div');c.className='card';const img=document.createElement('img');img.src=item.url;img.alt='';img.loading='lazy';const meta=document.createElement('div');meta.className='meta';const name=document.createElement('div');name.className='name';name.textContent=item.name;const a=document.createElement('div');a.className='actions';const copy=document.createElement('button');copy.className='button';copy.textContent='Copy URL';copy.onclick=async()=>{await navigator.clipboard.writeText(item.url);msg('Image URL copied.')};const del=document.createElement('button');del.className='button';del.textContent='Delete';del.onclick=async()=>{if(!confirm(`Delete ${item.name}?`))return;try{await api('/api/admin/media',{method:'DELETE',body:JSON.stringify({path:item.path,sha:item.sha})});msg('Image deleted.');await load()}catch(e){msg(e.message,false)}};a.append(copy,del);meta.append(name,a);c.append(img,meta);root.append(c)})}async function load(){try{const d=await api('/api/admin/media');media=d.media||[];render()}catch(e){msg(e.message,false)}}async function optimize(file){if(file.size>12*1024*1024)throw new Error('Image must be under 12 MB.');const bitmap=await createImageBitmap(file),max=1600,scale=Math.min(1,max/bitmap.width),canvas=document.createElement('canvas');canvas.width=Math.round(bitmap.width*scale);canvas.height=Math.round(bitmap.height*scale);canvas.getContext('2d').drawImage(bitmap,0,0,canvas.width,canvas.height);return new Promise((resolve,reject)=>canvas.toBlob(blob=>blob?resolve(blob):reject(new Error('Image conversion failed.')),'image/webp',.82))}$('upload').onclick=async()=>{const file=$('file').files?.[0];if(!file)return msg('Choose an image first.',false);try{const blob=await optimize(file),base64=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result).split(',')[1]);r.onerror=reject;r.readAsDataURL(blob)});await api('/api/admin/media',{method:'POST',body:JSON.stringify({name:file.name,type:'image/webp',base64})});msg('Image uploaded.');$('file').value='';await load()}catch(e){msg(e.message,false)}};$('refresh').onclick=load;load();</script></body></html>

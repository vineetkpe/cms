---
export const prerender = true;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Media Library · CMS</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#172033;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.main{padding:28px 30px 70px}.top{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:20px}.top h1{margin:0;font-size:1.75rem}.top p{margin:5px 0 0;color:#7a8494;font-size:.84rem}.actions{display:flex;gap:8px;flex-wrap:wrap}.button{border:1px solid #dfe3ea;background:#fff;border-radius:10px;padding:9px 13px;font-weight:750;cursor:pointer;color:#475467}.button.primary{background:#6d3df5;color:#fff;border-color:#6d3df5}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:15px}.stat{background:#fff;border:1px solid #e7eaf0;border-radius:15px;padding:16px;box-shadow:0 8px 24px rgba(16,24,40,.04)}.stat span{display:block;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;color:#98a2b3;font-weight:800}.stat strong{display:block;font-size:1.55rem;margin-top:5px}.upload-panel{background:#fff;border:1px solid #e7eaf0;border-radius:16px;padding:16px;margin-bottom:16px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:end;box-shadow:0 10px 30px rgba(16,24,40,.04)}.upload-box{border:1.5px dashed #d7dce5;border-radius:13px;padding:14px;background:#fbfcfe}.upload-box label{display:block;font-weight:800;font-size:.82rem;margin-bottom:5px}.upload-box small{color:#8a94a6;font-size:.72rem}.upload-box input{margin-top:10px;width:100%}.panel{background:#fff;border:1px solid #e7eaf0;border-radius:16px;box-shadow:0 10px 30px rgba(16,24,40,.045);overflow:hidden}.panel-head{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:14px 16px;border-bottom:1px solid #eef0f3}.panel-head input{border:1px solid #dfe3ea;border-radius:9px;padding:8px 10px;min-width:240px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0}.card{padding:11px;border-right:1px solid #f0f2f5;border-bottom:1px solid #f0f2f5}.thumb{background:#f4f6f9;border-radius:11px;overflow:hidden;aspect-ratio:16/10;display:grid;place-items:center}.thumb img{width:100%;height:100%;object-fit:cover}.name{font-size:.75rem;font-weight:800;margin-top:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.path{font-size:.67rem;color:#98a2b3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}.card-actions{display:flex;gap:6px;margin-top:8px}.mini{border:1px solid #e1e5eb;background:#fff;border-radius:8px;padding:6px 8px;color:#475467;font-size:.7rem;font-weight:750;cursor:pointer}.mini.danger{color:#b42318}.empty{padding:35px;color:#98a2b3;text-align:center;grid-column:1/-1}.msg{display:none;margin-bottom:13px;padding:10px 12px;border-radius:10px}.msg.show{display:block}.ok{background:#ecfdf3;color:#027a48}.err{background:#fef3f2;color:#b42318}@media(max-width:1000px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.stats{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}.upload-panel{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}}@media(max-width:480px){.grid{grid-template-columns:1fr}.panel-head{align-items:flex-start;flex-direction:column}.panel-head input{min-width:0;width:100%}}</style></head><body><main class="main" id="app" hidden><div class="top"><div><div class="cms-page-kicker">Assets</div><h1>Media library</h1><p>Optimized images stored in Cloudflare KV with free-tier safety limits.</p></div><div class="actions"><button class="button" id="refresh">Refresh</button><a class="button" href="/admin/editor/">Open editor</a></div></div><div id="msg" class="msg"></div><div class="stats"><div class="stat"><span>Media files</span><strong id="mediaCount">0</strong></div><div class="stat"><span>Storage used</span><strong id="storageUsage">0 MB</strong></div><div class="stat"><span>Upload limit</span><strong>2.5 MB</strong></div></div><section class="upload-panel"><div class="upload-box"><label>Upload image</label><small>JPEG, PNG, WebP or AVIF. The browser optimizes uploads to WebP before sending them.</small><input id="file" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></div><button id="upload" class="button primary">Optimize & upload</button></section><section class="panel"><div class="panel-head"><div><strong>Library</strong><div class="path" id="resultCount">0 files</div></div><input id="search" placeholder="Search media…"></div><div id="grid" class="grid"><div class="empty">Loading media…</div></div></section></main><script is:inline>const $=id=>document.getElementById(id);let media=[];const esc=v=>String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function msg(t,ok=true){const e=$('msg');e.textContent=t;e.className=`msg show ${ok?'ok':'err'}`;clearTimeout(e.t);e.t=setTimeout(()=>e.classList.remove('show'),4500)}async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json'},...opt}),d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}function render(){const q=$('search').value.trim().toLowerCase(),items=media.filter(i=>!q||`${i.name} ${i.path}`.toLowerCase().includes(q));$('mediaCount').textContent=media.length;$('resultCount').textContent=`${items.length} of ${media.length} files`;const root=$('grid');if(!items.length){root.innerHTML='<div class="empty">No matching media.</div>';return}root.innerHTML='';items.forEach(item=>{const c=document.createElement('article');c.className='card';c.innerHTML=`<div class="thumb"><img src="${esc(item.url)}" alt="" loading="lazy"></div><div class="name" title="${esc(item.name)}">${esc(item.name)}</div><div class="path" title="${esc(item.path)}">${esc(item.path)}</div><div class="card-actions"></div>`;const a=c.querySelector('.card-actions');const copy=document.createElement('button');copy.className='mini';copy.textContent='Copy URL';copy.onclick=async()=>{await navigator.clipboard.writeText(item.url).catch(()=>{});msg('Image URL copied.')};const del=document.createElement('button');del.className='mini danger';del.textContent='Delete';del.onclick=async()=>{if(!confirm(`Delete ${item.name}? Articles using this URL may show a broken image.`))return;try{await api('/api/admin/media',{method:'DELETE',body:JSON.stringify({path:item.path})});msg('Image deleted.');await load()}catch(e){msg(e.message,false)}};a.append(copy,del);root.append(c)})}async function load(){try{const d=await api('/api/admin/media');media=d.media||[];const u=d.usage||{};$('storageUsage').textContent=`${((Number(u.bytes||0))/1048576).toFixed(1)} / ${((Number(u.limitBytes||0))/1048576).toFixed(0)} MB`;render()}catch(e){msg(e.message,false);$('grid').innerHTML=`<div class="empty">${esc(e.message)}</div>`}}async function optimize(file){if(file.size>12*1024*1024)throw new Error('Original image must be under 12 MB.');const bitmap=await createImageBitmap(file),max=1400,scale=Math.min(1,max/bitmap.width),canvas=document.createElement('canvas');canvas.width=Math.round(bitmap.width*scale);canvas.height=Math.round(bitmap.height*scale);canvas.getContext('2d').drawImage(bitmap,0,0,canvas.width,canvas.height);return new Promise((resolve,reject)=>canvas.toBlob(blob=>blob?resolve(blob):reject(new Error('Image conversion failed.')),'image/webp',.8))}$('upload').onclick=async()=>{const file=$('file').files?.[0];if(!file)return msg('Choose an image first.',false);$('upload').disabled=true;try{const blob=await optimize(file),base64=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result).split(',')[1]);r.onerror=reject;r.readAsDataURL(blob)});await api('/api/admin/media',{method:'POST',body:JSON.stringify({name:file.name,type:'image/webp',base64})});msg('Image optimized and uploaded.');$('file').value='';await load()}catch(e){msg(e.message,false)}finally{$('upload').disabled=false}};$('search').oninput=render;$('refresh').onclick=load;api('/api/admin/login').then(d=>{if(!d.authenticated)throw new Error();$('app').hidden=false;load()}).catch(()=>location.replace('/admin/login/'));</script></body></html>

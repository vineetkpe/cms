---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>CMS Control Center</title>
  <style>
    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:#f5f7fa;color:#111827}.wrap{width:min(calc(100% - 32px),1050px);margin:0 auto;padding:54px 0 80px}.top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:34px}.kicker{font-size:.75rem;letter-spacing:.09em;text-transform:uppercase;color:#1769e0;font-weight:800}.top h1{font-size:clamp(2rem,5vw,3.5rem);letter-spacing:-.05em;margin:7px 0 3px}.top p{color:#667085;margin:0}.site{border:1px solid #e2e7ee;background:#fff;border-radius:9px;padding:9px 13px;text-decoration:none;color:#344054;font-weight:700}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.card{display:block;background:#fff;border:1px solid #e2e7ee;border-radius:15px;padding:24px;text-decoration:none;color:inherit;box-shadow:0 7px 22px rgba(16,24,40,.035);transition:.18s}.card:hover{border-color:#1769e0;transform:translateY(-2px)}.icon{width:42px;height:42px;display:grid;place-items:center;border-radius:10px;background:#eef4ff;color:#1769e0;font-weight:900;margin-bottom:18px}.card h2{margin:0 0 7px;font-size:1.2rem}.card p{margin:0;color:#667085;line-height:1.55}.note{margin-top:26px;padding:16px 18px;border:1px solid #d0d5dd;border-radius:12px;color:#667085;background:#fff;font-size:.9rem}@media(max-width:700px){.grid{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}.wrap{padding-top:32px}}
  </style>
</head>
<body>
<main class="wrap">
  <div class="top"><div><div class="kicker">Private administration</div><h1>Control Center</h1><p>Manage content, trust pages, media and publishing settings.</p></div><a class="site" href="/" target="_blank">View website ↗</a></div>
  <div class="grid">
    <a class="card" href="/admin/content/"><div class="icon">Aa</div><h2>Content & SEO</h2><p>Write posts, manage drafts, schedule publishing, redirects, FAQs, analytics, ads and site settings.</p></a>
    <a class="card" href="/admin/pages/"><div class="icon">Pg</div><h2>Trust & legal pages</h2><p>Edit About, Contact, Privacy, Terms, Disclaimer and Editorial Policy from one place.</p></a>
    <a class="card" href="/admin/media/"><div class="icon">Im</div><h2>Media library</h2><p>Upload optimized images, browse existing media, copy URLs and remove unused files.</p></a>
    <a class="card" href="/articles/" target="_blank"><div class="icon">↗</div><h2>Public archive</h2><p>Review the paginated public article archive before launch.</p></a>
  </div>
  <div class="note">Cloudflare deployment is intentionally not configured yet. The CMS code can be completed and tested first, then deployment/authentication secrets are added once.</div>
</main>
</body>
</html>

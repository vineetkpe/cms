---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>CMS Control Center</title>
  <style>
    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:#f5f7fa;color:#111827}.wrap{width:min(calc(100% - 32px),1120px);margin:0 auto;padding:54px 0 80px}.top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:34px}.kicker{font-size:.75rem;letter-spacing:.09em;text-transform:uppercase;color:#1769e0;font-weight:800}.top h1{font-size:clamp(2rem,5vw,3.5rem);letter-spacing:-.05em;margin:7px 0 3px}.top p{color:#667085;margin:0}.actions{display:flex;gap:8px;align-items:center}.site,.logout{border:1px solid #e2e7ee;background:#fff;border-radius:9px;padding:9px 13px;text-decoration:none;color:#344054;font-weight:700;font:inherit;cursor:pointer}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{display:block;background:#fff;border:1px solid #e2e7ee;border-radius:14px;padding:22px;text-decoration:none;color:inherit;box-shadow:0 5px 18px rgba(16,24,40,.025);transition:.15s}.card:hover{border-color:#a9bfe6;transform:translateY(-1px)}.icon{width:38px;height:38px;display:grid;place-items:center;border-radius:9px;background:#eef4ff;color:#1769e0;font-weight:900;margin-bottom:16px}.card h2{margin:0 0 6px;font-size:1.12rem}.card p{margin:0;color:#667085;line-height:1.5;font-size:.9rem}.note{margin-top:24px;padding:15px 17px;border:1px solid #d0d5dd;border-radius:11px;color:#667085;background:#fff;font-size:.88rem}.session{font-size:.82rem;color:#667085;margin-top:5px}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.grid{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}.wrap{padding-top:32px}.actions{width:100%;flex-wrap:wrap}}
  </style>
</head>
<body>
<main class="wrap" id="app" hidden>
  <div class="top"><div><div class="kicker">Private administration</div><h1>Control Center</h1><p>Publishing, SEO, appearance and site operations.</p><div class="session" id="sessionLabel"></div></div><div class="actions"><a class="site" href="/" target="_blank">View website ↗</a><button class="logout" id="logout">Sign out</button></div></div>
  <div class="grid">
    <a class="card" href="/admin/content/"><div class="icon">Aa</div><h2>Posts & SEO</h2><p>Write, schedule and publish posts with metadata, FAQs, images, tags and ad controls.</p></a>
    <a class="card editor-only" href="/admin/pages/"><div class="icon">Pg</div><h2>Pages & SEO</h2><p>Edit About, Contact, Privacy, Terms, Disclaimer and Editorial Policy with page-level SEO.</p></a>
    <a class="card admin-only" href="/admin/settings/"><div class="icon">St</div><h2>Appearance & settings</h2><p>Brand, logo, colors, navigation, footer, analytics, Search Console and AdSense.</p></a>
    <a class="card" href="/admin/media/"><div class="icon">Im</div><h2>Media library</h2><p>Upload optimized images, browse existing media and copy public URLs.</p></a>
    <a class="card editor-only" href="/admin/content/#redirects"><div class="icon">301</div><h2>Redirects</h2><p>Maintain static SEO redirects that are generated during each site build.</p></a>
    <a class="card" href="/articles/" target="_blank"><div class="icon">↗</div><h2>Public archive</h2><p>Review the public article archive and published content.</p></a>
  </div>
  <div class="note">Public pages stay static. CMS accounts use Worker-secret password hashes and signed HttpOnly sessions; drafts are encrypted before they are committed to GitHub.</div>
</main>
<script is:inline>
  const app = document.querySelector('#app');
  const label = document.querySelector('#sessionLabel');
  fetch('/api/admin/login', { credentials: 'same-origin', cache: 'no-store' }).then(async (response) => {
    if (!response.ok) { location.replace('/admin/login/'); return; }
    const data = await response.json();
    const role = data.user?.role || 'member';
    if (label instanceof HTMLElement) label.textContent = `${data.user?.displayName || data.user?.username || 'CMS user'} · ${role}`;
    if (!['owner','admin'].includes(role)) document.querySelectorAll('.admin-only').forEach((node) => node.remove());
    if (!['owner','admin','editor'].includes(role)) document.querySelectorAll('.editor-only').forEach((node) => node.remove());
    if (app instanceof HTMLElement) app.hidden = false;
  }).catch(() => location.replace('/admin/login/'));
  document.querySelector('#logout')?.addEventListener('click', async () => {
    await fetch('/api/admin/login', { method: 'DELETE', credentials: 'same-origin' }).catch(() => {});
    location.replace('/admin/login/');
  });
</script>
</body>
</html>

---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>CMS Dashboard</title>
  <style>
    :root{--bg:#f5f6fb;--panel:#fff;--text:#151625;--muted:#7a8194;--line:#eaebf2;--purple:#7c3aed;--purple2:#5b21b6;--violet:#ede9fe;--green:#10b981;--cyan:#22c7e8;--orange:#fb923c;--pink:#ec4899;--shadow:0 10px 30px rgba(42,28,87,.055)}
    *{box-sizing:border-box}html{background:var(--bg)}body{margin:0;color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);font-size:14px}a{color:inherit;text-decoration:none}button,input{font:inherit}.app{min-height:100vh;display:grid;grid-template-columns:224px minmax(0,1fr)}
    .sidebar{background:#fff;border-right:1px solid var(--line);padding:22px 14px;display:flex;flex-direction:column;gap:18px;position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:10px;padding:4px 9px 18px}.brandmark{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,#8b5cf6,#5b21b6);color:#fff;font-weight:900;box-shadow:0 8px 18px rgba(124,58,237,.22)}.brandtext strong{display:block;font-size:1rem}.brandtext span{color:#98a2b3;font-size:.7rem}.side-section{display:grid;gap:5px}.side-label{padding:10px 10px 5px;color:#b0b5c2;font-size:.64rem;text-transform:uppercase;letter-spacing:.13em;font-weight:850}.nav{display:flex;align-items:center;gap:10px;padding:10px 11px;border-radius:9px;color:#73798a;font-size:.82rem;font-weight:680}.nav:hover{background:#f8f7ff;color:#4f46e5}.nav.active{background:#f1edff;color:#6d28d9}.nav i{width:22px;height:22px;border-radius:7px;display:grid;place-items:center;font-style:normal;font-size:.75rem;background:#f5f3ff;color:#7c3aed}.side-spacer{flex:1}.account{border-top:1px solid var(--line);padding:15px 9px 0;display:grid;gap:9px}.account-name{font-size:.76rem;color:#667085}.side-button{border:1px solid var(--line);background:#fff;padding:9px 10px;border-radius:8px;cursor:pointer;color:#667085;font-weight:700;text-align:left}.side-button:hover{background:#f8f9fb}
    .workspace{min-width:0;padding:0 28px 46px}.topbar{height:74px;display:flex;align-items:center;justify-content:space-between;gap:20px}.titleblock h1{margin:0;font-size:1.42rem;letter-spacing:-.035em}.titleblock p{margin:3px 0 0;color:#98a2b3;font-size:.76rem}.top-actions{display:flex;align-items:center;gap:9px}.search{width:min(330px,32vw);height:40px;border:1px solid var(--line);background:#fff;border-radius:10px;padding:0 13px;color:#475467;outline:none}.search:focus{border-color:#c4b5fd;box-shadow:0 0 0 3px #ede9fe}.button{height:40px;border-radius:10px;padding:0 14px;border:1px solid var(--line);background:#fff;color:#475467;font-weight:750;cursor:pointer;display:inline-flex;align-items:center;gap:7px}.button:hover{border-color:#d0d5dd}.button.primary{background:linear-gradient(135deg,#8b5cf6,#6d28d9);color:#fff;border-color:transparent;box-shadow:0 8px 18px rgba(124,58,237,.18)}
    .kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:14px}.kpi{background:#fff;border:1px solid var(--line);border-radius:14px;padding:17px 17px 14px;box-shadow:var(--shadow);min-width:0}.kpi-top{display:flex;justify-content:space-between;align-items:center;gap:12px}.kpi-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;font-weight:900}.kpi-icon.purple{background:#f0eafe;color:#7c3aed}.kpi-icon.cyan{background:#e9fbff;color:#0891b2}.kpi-icon.orange{background:#fff3e8;color:#ea580c}.kpi-icon.pink{background:#fdf0f7;color:#db2777}.kpi-label{color:#8a91a2;font-size:.72rem;font-weight:700}.kpi-value{margin-top:9px;font-size:1.7rem;font-weight:850;letter-spacing:-.05em}.kpi-foot{margin-top:7px;color:#a1a7b5;font-size:.68rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.spark{width:56px;height:24px}
    .grid-main{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(300px,.75fr);gap:14px;margin-bottom:14px}.panel{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);min-width:0;overflow:hidden}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:16px 17px 13px;border-bottom:1px solid #f0f1f5}.panel-head h2{margin:0;font-size:.88rem}.panel-head p{margin:4px 0 0;color:#98a2b3;font-size:.68rem}.panel-body{padding:16px 17px}.traffic-wrap{height:260px;position:relative}.traffic-svg{width:100%;height:100%;overflow:visible}.axis-note{display:flex;justify-content:space-between;color:#abb0bc;font-size:.64rem;margin-top:-4px}.legend{display:flex;align-items:center;gap:12px;color:#858b99;font-size:.68rem}.legend span{display:flex;align-items:center;gap:5px}.dot{width:7px;height:7px;border-radius:999px;background:#7c3aed}.dot.cyan{background:#21c4df}
    .donut-wrap{display:grid;place-items:center;padding:6px 0 12px}.donut{width:150px;height:150px;border-radius:50%;display:grid;place-items:center;position:relative;background:conic-gradient(#7c3aed 0 65%,#22c7e8 65% 82%,#fb923c 82% 100%)}.donut::after{content:"";width:104px;height:104px;border-radius:50%;background:#fff;position:absolute}.donut-center{position:relative;z-index:2;text-align:center}.donut-center strong{display:block;font-size:1.5rem;letter-spacing:-.05em}.donut-center span{color:#98a2b3;font-size:.66rem}.status-list{display:grid;gap:10px}.status-row{display:flex;align-items:center;justify-content:space-between;color:#667085;font-size:.73rem}.status-row b{color:#344054}.status-left{display:flex;align-items:center;gap:8px}.status-left i{width:8px;height:8px;border-radius:999px;background:#7c3aed}.status-left i.scheduled{background:#22c7e8}.status-left i.draft{background:#fb923c}
    .trend-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:14px;margin-bottom:14px}.trend-panel{background:linear-gradient(180deg,#fff 0%,#fcfbff 100%)}.trend-headline{display:flex;align-items:center;gap:8px}.ai-badge{font-size:.62rem;padding:4px 7px;border-radius:999px;background:#f0e9ff;color:#6d28d9;font-weight:800}.trend-source{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.trend-chip{border:1px solid #ece9f8;border-radius:999px;background:#fff;padding:6px 9px;color:#6f7481;font-size:.67rem}.ideas{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.idea{border:1px solid #ecebf2;border-radius:12px;background:#fff;padding:13px;min-width:0}.idea-top{display:flex;justify-content:space-between;align-items:start;gap:8px}.idea h3{margin:0;font-size:.79rem;line-height:1.35}.urgency{font-size:.58rem;border-radius:999px;padding:3px 6px;background:#f2f4f7;color:#667085;font-weight:850;white-space:nowrap}.urgency.High{background:#fff0f0;color:#c2410c}.urgency.Medium{background:#fff7e6;color:#b45309}.idea p{margin:7px 0 9px;color:#8a91a2;font-size:.67rem;line-height:1.45}.idea-meta{display:flex;justify-content:space-between;gap:8px;align-items:center}.keyword{font-size:.61rem;color:#6941c6;background:#f5f3ff;padding:4px 6px;border-radius:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:75%}.copy{border:0;background:transparent;color:#7c3aed;font-size:.64rem;font-weight:800;cursor:pointer}.trend-actions{display:flex;gap:8px;align-items:center}.mini-button{border:1px solid #e4e0f1;background:#fff;color:#6d28d9;border-radius:8px;padding:7px 9px;font-size:.66rem;font-weight:800;cursor:pointer}.mini-button:disabled{opacity:.55;cursor:wait}.empty{color:#a1a7b5;font-size:.72rem;padding:8px 0}.trend-error{color:#b42318;background:#fff4f2;border:1px solid #fecdca;border-radius:9px;padding:10px;font-size:.7rem}
    .list{display:grid}.row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid #f0f1f4}.row:last-child{border-bottom:0}.row-title{font-size:.74rem;font-weight:760;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row-sub{margin-top:3px;color:#9aa0ad;font-size:.63rem}.row-value{font-size:.73rem;font-weight:850;color:#344054}.progress{height:5px;background:#f1f2f6;border-radius:999px;margin-top:7px;overflow:hidden}.progress i{display:block;height:100%;background:linear-gradient(90deg,#8b5cf6,#6d28d9);border-radius:999px}.queue-time{padding:5px 7px;border-radius:7px;background:#f8f5ff;color:#6d28d9;font-size:.61rem;font-weight:800}.search-console{display:grid;gap:12px}.search-state{border:1px dashed #d9d6e8;border-radius:11px;padding:15px;background:#fcfbff}.search-state strong{display:block;font-size:.78rem}.search-state p{margin:5px 0 0;color:#8e94a2;font-size:.67rem;line-height:1.48}.search-metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.fake-metric{background:#f8f9fb;border-radius:9px;padding:10px;color:#a4a9b5}.fake-metric b{display:block;font-size:.9rem;color:#6f7584}.footer-note{margin-top:14px;color:#9aa0ad;font-size:.65rem;text-align:right}
    @media(max-width:1120px){.app{grid-template-columns:190px minmax(0,1fr)}.kpis{grid-template-columns:repeat(2,1fr)}.ideas{grid-template-columns:1fr}.grid-main,.trend-layout{grid-template-columns:1fr}}
    @media(max-width:780px){.app{display:block}.sidebar{position:relative;height:auto;border-right:0;border-bottom:1px solid var(--line);padding:12px}.brand{padding-bottom:6px}.side-section{display:flex;overflow-x:auto}.side-label,.side-spacer,.account{display:none}.nav{flex:0 0 auto}.workspace{padding:0 14px 34px}.topbar{height:auto;padding:16px 0;align-items:flex-start}.search{display:none}.kpis{grid-template-columns:1fr 1fr}.ideas{grid-template-columns:1fr}}
    @media(max-width:460px){.kpis{grid-template-columns:1fr}.top-actions .button:not(.primary){display:none}.workspace{padding-inline:10px}}
  </style>
</head>
<body>
<div class="app" id="app" hidden>
  <aside class="sidebar">
    <div class="brand"><div class="brandmark">C</div><div class="brandtext"><strong>CMS Studio</strong><span>Publishing OS</span></div></div>
    <div class="side-section">
      <div class="side-label">Workspace</div>
      <a class="nav active" href="/admin/"><i>⌂</i>Overview</a>
      <a class="nav" href="/admin/content/"><i>▤</i>Posts</a>
      <a class="nav" href="/admin/editor/"><i>✎</i>New article</a>
      <a class="nav" href="/admin/media/"><i>◫</i>Media</a>
      <a class="nav editor-only" href="/admin/pages/"><i>Pg</i>Pages & SEO</a>
    </div>
    <div class="side-section">
      <div class="side-label">Operations</div>
      <a class="nav admin-only" href="/admin/settings/"><i>⚙</i>Settings</a>
      <a class="nav editor-only" href="/admin/tools/"><i>↕</i>Backups & tools</a>
      <a class="nav" href="/articles/" target="_blank"><i>↗</i>View site</a>
    </div>
    <div class="side-spacer"></div>
    <div class="account"><div class="account-name" id="sessionLabel">CMS user</div><button class="side-button" id="logout">Sign out</button></div>
  </aside>

  <main class="workspace">
    <header class="topbar">
      <div class="titleblock"><h1>Overview</h1><p>Content performance, publishing and live trend research.</p></div>
      <div class="top-actions"><input class="search" id="dashboardSearch" type="search" placeholder="Search posts…"><a class="button" href="/" target="_blank">View site ↗</a><a class="button primary" href="/admin/editor/">＋ New article</a></div>
    </header>

    <section class="kpis" aria-label="CMS summary">
      <article class="kpi"><div class="kpi-top"><div><div class="kpi-label">Views · 30 days</div><div class="kpi-value" id="views30">—</div></div><div class="kpi-icon purple">↗</div></div><div class="kpi-foot" id="views7">Collecting traffic</div></article>
      <article class="kpi"><div class="kpi-top"><div><div class="kpi-label">Published posts</div><div class="kpi-value" id="publishedCount">—</div></div><div class="kpi-icon cyan">Aa</div></div><div class="kpi-foot" id="publishedFoot">Live and indexable</div></article>
      <article class="kpi"><div class="kpi-top"><div><div class="kpi-label">Scheduled</div><div class="kpi-value" id="scheduledCount">—</div></div><div class="kpi-icon orange">◷</div></div><div class="kpi-foot">Automated publishing queue</div></article>
      <article class="kpi"><div class="kpi-top"><div><div class="kpi-label">Drafts</div><div class="kpi-value" id="draftCount">—</div></div><div class="kpi-icon pink">✎</div></div><div class="kpi-foot">Private work in progress</div></article>
    </section>

    <section class="grid-main">
      <article class="panel">
        <div class="panel-head"><div><h2>Traffic trend</h2><p>First-party article views · last 30 days</p></div><div class="legend"><span><i class="dot"></i>Views</span></div></div>
        <div class="panel-body"><div class="traffic-wrap" id="trafficChart"><div class="empty">Collecting page-view data…</div></div><div class="axis-note"><span>30 days ago</span><span>Today</span></div></div>
      </article>
      <article class="panel">
        <div class="panel-head"><div><h2>Content mix</h2><p>Publishing status across the CMS</p></div></div>
        <div class="panel-body"><div class="donut-wrap"><div class="donut" id="statusDonut"><div class="donut-center"><strong id="totalPosts">—</strong><span>Total posts</span></div></div></div><div class="status-list"><div class="status-row"><span class="status-left"><i></i>Published</span><b id="statusPublished">—</b></div><div class="status-row"><span class="status-left"><i class="scheduled"></i>Scheduled</span><b id="statusScheduled">—</b></div><div class="status-row"><span class="status-left"><i class="draft"></i>Draft</span><b id="statusDraft">—</b></div></div></div>
      </article>
    </section>

    <section class="trend-layout">
      <article class="panel trend-panel">
        <div class="panel-head"><div><div class="trend-headline"><h2>Trend Intelligence</h2><span class="ai-badge" id="aiBadge">Google Trends</span></div><p id="trendSubtitle">Finding fresh topics related to your niche…</p></div><div class="trend-actions"><button class="mini-button" id="refreshTrends">Refresh</button><button class="mini-button" id="aiIdeas">Refresh ideas</button></div></div>
        <div class="panel-body"><div class="trend-source" id="trendSource"><span class="trend-chip">Loading live trends…</span></div><div class="ideas" id="trendIdeas"><div class="empty">Loading topic opportunities…</div></div></div>
      </article>
      <article class="panel">
        <div class="panel-head"><div><h2>Top articles</h2><p>Views in the last 30 days</p></div><a class="mini-button" href="/admin/content/">All posts</a></div>
        <div class="panel-body list" id="topPosts"><div class="empty">No traffic yet.</div></div>
      </article>
    </section>

    <section class="grid-main">
      <article class="panel"><div class="panel-head"><div><h2>Publishing schedule</h2><p>Upcoming automated releases</p></div><a class="mini-button" href="/admin/editor/">Schedule post</a></div><div class="panel-body list" id="scheduleList"><div class="empty">No scheduled posts.</div></div></article>
      <article class="panel"><div class="panel-head"><div><h2>Search visibility</h2><p>Google Search Console</p></div><span class="ai-badge">Optional</span></div><div class="panel-body search-console"><div class="search-state"><strong>Search Console is not connected yet</strong><p>When we add Google Search Console API credentials, this card can show real clicks, impressions, CTR and average position. No fake ranking data is displayed.</p></div><div class="search-metrics"><div class="fake-metric"><b>—</b>Clicks</div><div class="fake-metric"><b>—</b>Avg. position</div></div></div></article>
    </section>

    <div class="footer-note">Traffic is stored in D1. Trend ideas are based on Google Trends and your configured niche. Zero-cost mode uses no paid AI inference.</div>
  </main>
</div>
<script is:inline>
  const app = document.querySelector('#app');
  const fmt = (n) => new Intl.NumberFormat().format(Number(n || 0));
  const esc = (v) => String(v || '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},...opt});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}
  function daySeries(daily){const map=new Map((daily||[]).map(i=>[i.day,Number(i.views||0)]));const out=[];for(let i=29;i>=0;i--){const day=new Date(Date.now()-i*86400000).toISOString().slice(0,10);out.push({day,views:map.get(day)||0})}return out}
  function renderTraffic(daily){const root=document.querySelector('#trafficChart');if(!(root instanceof HTMLElement))return;const data=daySeries(daily);const max=Math.max(1,...data.map(i=>i.views));const width=760,height=240,padX=12,padY=18;const points=data.map((item,i)=>{const x=padX+(i/(data.length-1))*(width-padX*2);const y=height-padY-(item.views/max)*(height-padY*2);return{x,y,...item}});const line=points.map((p,i)=>`${i?'L':'M'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');const area=`${line} L ${points.at(-1).x.toFixed(1)} ${height-padY} L ${points[0].x.toFixed(1)} ${height-padY} Z`;const grid=[.25,.5,.75,1].map(v=>`<line x1="${padX}" y1="${height-padY-v*(height-padY*2)}" x2="${width-padX}" y2="${height-padY-v*(height-padY*2)}" stroke="#f0f1f5" stroke-width="1"/>`).join('');root.innerHTML=`<svg class="traffic-svg" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none"><defs><linearGradient id="trafficFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#8b5cf6" stop-opacity=".24"/><stop offset="100%" stop-color="#8b5cf6" stop-opacity="0"/></linearGradient></defs>${grid}<path d="${area}" fill="url(#trafficFill)"/><path d="${line}" fill="none" stroke="#7c3aed" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>${points.filter((_,i)=>i===points.length-1||i===Math.floor(points.length/2)).map(p=>`<circle cx="${p.x}" cy="${p.y}" r="4" fill="#fff" stroke="#7c3aed" stroke-width="3"><title>${p.day}: ${p.views} views</title></circle>`).join('')}</svg>`}
  function renderDonut(published,scheduled,drafts){const total=Math.max(1,published+scheduled+drafts);const p=published/total*100,s=scheduled/total*100;const donut=document.querySelector('#statusDonut');if(donut instanceof HTMLElement)donut.style.background=`conic-gradient(#7c3aed 0 ${p}%,#22c7e8 ${p}% ${p+s}%,#fb923c ${p+s}% 100%)`;document.querySelector('#totalPosts').textContent=fmt(published+scheduled+drafts);document.querySelector('#statusPublished').textContent=fmt(published);document.querySelector('#statusScheduled').textContent=fmt(scheduled);document.querySelector('#statusDraft').textContent=fmt(drafts)}
  function renderTop(items,posts){const root=document.querySelector('#topPosts');if(!(root instanceof HTMLElement))return;const map=new Map((posts||[]).map(p=>[p.slug,p.title]));const max=Math.max(1,...(items||[]).map(i=>Number(i.views||0)));root.innerHTML=items?.length?items.map(i=>`<div class="row"><div><div class="row-title">${esc(map.get(i.slug)||i.slug)}</div><div class="progress"><i style="width:${Math.max(4,Math.round(Number(i.views||0)/max*100))}%"></i></div></div><div class="row-value">${fmt(i.views)}</div></div>`).join(''):'<div class="empty">No traffic yet.</div>'}
  function renderSchedule(items,posts){const root=document.querySelector('#scheduleList');if(!(root instanceof HTMLElement))return;const map=new Map((posts||[]).map(p=>[p.slug,p.title]));root.innerHTML=items?.length?items.map(i=>`<div class="row"><div><div class="row-title">${esc(map.get(i.slug)||i.slug)}</div><div class="row-sub">${new Date(i.publishAt).toLocaleString()}</div></div><a class="queue-time" href="/admin/editor/?slug=${encodeURIComponent(i.slug)}">Edit</a></div>`).join(''):'<div class="empty">No scheduled posts.</div>'}
  function renderTrends(data){const source=document.querySelector('#trendSource'),ideas=document.querySelector('#trendIdeas'),subtitle=document.querySelector('#trendSubtitle'),badge=document.querySelector('#aiBadge');if(subtitle instanceof HTMLElement)subtitle.textContent=`${data.niche||'Configured niche'} · ${data.geo||'IN'} · refreshed ${new Date(data.generatedAt||Date.now()).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}`;if(badge instanceof HTMLElement)badge.textContent=data.aiCached?'AI cached + Trends':'Google Trends';if(source instanceof HTMLElement){const trends=(data.trends||[]).slice(0,6);source.innerHTML=trends.length?trends.map(t=>`<span class="trend-chip">↗ ${esc(t.title)}${t.traffic?` · ${esc(t.traffic)}`:''}</span>`).join(''):'<span class="trend-chip">No strong niche match right now</span>'}if(ideas instanceof HTMLElement){const list=data.ideas||[];ideas.innerHTML=list.length?list.map((idea,index)=>`<article class="idea"><div class="idea-top"><h3>${esc(idea.title)}</h3><span class="urgency ${esc(idea.urgency)}">${esc(idea.urgency||'Normal')}</span></div><p>${esc(idea.angle||idea.reason||'Editorial opportunity based on current search interest.')}</p><div class="idea-meta"><span class="keyword">${esc(idea.primaryKeyword||idea.sourceTrend||'topic')}</span><button class="copy" data-copy="${encodeURIComponent(idea.title)}">Copy idea</button></div></article>`).join(''):'<div class="empty">No niche-specific ideas found in the current trend window.</div>';ideas.querySelectorAll('[data-copy]').forEach(btn=>btn.addEventListener('click',async()=>{const text=decodeURIComponent(btn.getAttribute('data-copy')||'');await navigator.clipboard.writeText(text).catch(()=>{});btn.textContent='Copied';setTimeout(()=>btn.textContent='Copy idea',1200)}))}}
  async function loadTrends(){const ideas=document.querySelector('#trendIdeas');if(ideas instanceof HTMLElement)ideas.innerHTML='<div class="empty">Scanning live Google Trends…</div>';try{const data=await api('/api/admin/trends');renderTrends(data)}catch(error){if(ideas instanceof HTMLElement)ideas.innerHTML=`<div class="trend-error">${esc(error instanceof Error?error.message:'Unable to load Google Trends.')}</div>`}}
  document.querySelector('#refreshTrends')?.addEventListener('click',loadTrends);
  document.querySelector('#aiIdeas')?.addEventListener('click',async(event)=>{const btn=event.currentTarget;if(!(btn instanceof HTMLButtonElement))return;btn.disabled=true;btn.textContent='Generating…';try{const data=await api('/api/admin/trends',{method:'POST',body:'{}'});renderTrends({...data,trends:[],aiCached:data.aiUsed});btn.textContent=data.aiUsed?'AI ideas ready':'Ideas refreshed'}catch(error){btn.textContent='AI unavailable'}finally{setTimeout(()=>{btn.disabled=false;btn.textContent='Generate AI angles'},1600)}});
  Promise.all([api('/api/admin/login'),api('/api/admin/posts'),api('/api/admin/analytics')]).then(([auth,postData,analytics])=>{const role=auth.user?.role||'member';const label=document.querySelector('#sessionLabel');if(label instanceof HTMLElement)label.textContent=`${auth.user?.displayName||auth.user?.username||'CMS user'} · ${role}`;if(!['owner','admin'].includes(role))document.querySelectorAll('.admin-only').forEach(n=>n.remove());if(!['owner','admin','editor'].includes(role))document.querySelectorAll('.editor-only').forEach(n=>n.remove());const posts=postData.posts||[],now=Date.now();const published=posts.filter(p=>!p.draft&&Date.parse(p.publishAt||`${p.pubDate}T00:00:00Z`)<=now).length,scheduled=posts.filter(p=>!p.draft&&Date.parse(p.publishAt||`${p.pubDate}T00:00:00Z`)>now).length,drafts=posts.filter(p=>p.draft).length;document.querySelector('#publishedCount').textContent=fmt(published);document.querySelector('#scheduledCount').textContent=fmt(scheduled);document.querySelector('#draftCount').textContent=fmt(drafts);document.querySelector('#views30').textContent=fmt(analytics.views?.last30Days);document.querySelector('#views7').textContent=`${fmt(analytics.views?.last7Days)} views in the last 7 days · ${fmt(analytics.views?.today)} today`;renderTraffic(analytics.daily);renderDonut(published,scheduled,drafts);renderTop(analytics.topPosts,posts);renderSchedule(analytics.scheduled,posts);if(app instanceof HTMLElement)app.hidden=false;loadTrends();const search=document.querySelector('#dashboardSearch');search?.addEventListener('keydown',(e)=>{if(e.key==='Enter'&&search.value.trim())location.href=`/admin/content/?q=${encodeURIComponent(search.value.trim())}`})}).catch(()=>location.replace('/admin/login/'));
  document.querySelector('#logout')?.addEventListener('click',async()=>{await fetch('/api/admin/login',{method:'DELETE',credentials:'same-origin'}).catch(()=>{});location.replace('/admin/login/')});
</script>
</body>
</html>

---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>CMS Control Center</title>
  <style>
    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:#f4f6f8;color:#101828}.wrap{width:min(calc(100% - 32px),1240px);margin:0 auto;padding:38px 0 80px}.top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:26px}.kicker{font-size:.72rem;letter-spacing:.11em;text-transform:uppercase;color:#1769e0;font-weight:850}.top h1{font-size:clamp(2rem,5vw,3.25rem);letter-spacing:-.055em;margin:6px 0 3px}.top p{color:#667085;margin:0}.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.site,.logout,.btn{border:1px solid #dbe1e8;background:#fff;border-radius:9px;padding:9px 13px;text-decoration:none;color:#344054;font-weight:700;font:inherit;cursor:pointer}.btn.primary{background:#1769e0;border-color:#1769e0;color:#fff}.session{font-size:.82rem;color:#667085;margin-top:5px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:18px}.stat{background:#fff;border:1px solid #e1e6ed;border-radius:14px;padding:18px;box-shadow:0 5px 18px rgba(16,24,40,.025)}.stat span{display:block;color:#667085;font-size:.76rem;font-weight:700}.stat strong{display:block;margin-top:5px;font-size:1.85rem;letter-spacing:-.045em}.dashboard{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(320px,.6fr);gap:16px;margin-bottom:18px}.panel{background:#fff;border:1px solid #e1e6ed;border-radius:14px;overflow:hidden}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 18px;border-bottom:1px solid #edf0f3}.panel-head h2{margin:0;font-size:.98rem}.panel-body{padding:18px}.bar-chart{height:170px;display:flex;align-items:end;gap:5px;border-bottom:1px solid #e7ebf0;padding-top:18px}.bar{flex:1;min-width:4px;background:#1769e0;border-radius:4px 4px 0 0;opacity:.82}.chart-note{display:flex;justify-content:space-between;margin-top:9px;color:#98a2b3;font-size:.7rem}.list{display:grid}.row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;padding:12px 0;border-bottom:1px solid #edf0f3;align-items:center}.row:last-child{border-bottom:0}.row strong{font-size:.88rem}.row small{display:block;color:#667085;margin-top:2px}.number{font-weight:800;font-size:.9rem}.empty{color:#98a2b3;font-size:.85rem;padding:8px 0}.notice{border:1px solid #fedf89;background:#fffaeb;color:#93370d;border-radius:11px;padding:13px 14px;font-size:.82rem;line-height:1.5}.quick-title{font-size:.8rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#667085;margin:25px 0 11px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.card{display:block;background:#fff;border:1px solid #e1e6ed;border-radius:14px;padding:18px;text-decoration:none;color:inherit;box-shadow:0 5px 18px rgba(16,24,40,.02);transition:.15s}.card:hover{border-color:#a9bfe6;transform:translateY(-1px)}.icon{width:35px;height:35px;display:grid;place-items:center;border-radius:9px;background:#eef4ff;color:#1769e0;font-weight:900;margin-bottom:13px}.card h2{margin:0 0 5px;font-size:1rem}.card p{margin:0;color:#667085;line-height:1.45;font-size:.82rem}.note{margin-top:20px;padding:14px 16px;border:1px solid #d0d5dd;border-radius:11px;color:#667085;background:#fff;font-size:.83rem}@media(max-width:980px){.stats,.grid{grid-template-columns:repeat(2,1fr)}.dashboard{grid-template-columns:1fr}}@media(max-width:620px){.stats,.grid{grid-template-columns:1fr 1fr}.top{align-items:flex-start;flex-direction:column}.wrap{padding-top:28px}.actions{width:100%}}@media(max-width:440px){.stats,.grid{grid-template-columns:1fr}}
  </style>
</head>
<body>
<main class="wrap" id="app" hidden>
  <div class="top">
    <div><div class="kicker">Private administration</div><h1>Control Center</h1><p>Publishing, traffic, SEO, scheduling and site operations.</p><div class="session" id="sessionLabel"></div></div>
    <div class="actions"><a class="btn primary" href="/admin/editor/">+ New article</a><a class="site" href="/" target="_blank">View website ↗</a><button class="logout" id="logout">Sign out</button></div>
  </div>

  <section class="stats" aria-label="CMS summary">
    <div class="stat"><span>Published posts</span><strong id="publishedCount">—</strong></div>
    <div class="stat"><span>Scheduled</span><strong id="scheduledCount">—</strong></div>
    <div class="stat"><span>Views · 30 days</span><strong id="views30">—</strong></div>
    <div class="stat"><span>Views · today</span><strong id="viewsToday">—</strong></div>
  </section>

  <section class="dashboard">
    <div class="panel"><div class="panel-head"><h2>Traffic · last 30 days</h2><span class="session" id="views7"></span></div><div class="panel-body"><div class="bar-chart" id="trafficChart"><div class="empty">Collecting page-view data…</div></div><div class="chart-note"><span>30 days ago</span><span>Today</span></div></div></div>
    <div class="panel"><div class="panel-head"><h2>Top articles</h2><a class="session" href="/admin/content/">All posts →</a></div><div class="panel-body list" id="topPosts"><div class="empty">No traffic yet.</div></div></div>
  </section>

  <section class="dashboard">
    <div class="panel"><div class="panel-head"><h2>Scheduled publishing</h2><a class="session" href="/admin/editor/">Schedule article →</a></div><div class="panel-body list" id="scheduleList"><div class="empty">No scheduled posts.</div></div></div>
    <div class="panel"><div class="panel-head"><h2>Google Search Console</h2><span class="session">Optional</span></div><div class="panel-body"><div class="notice">Search Console data is not connected yet. The CMS is ready for an API integration later; until then it will not invent clicks, impressions, CTR or ranking data.</div></div></div>
  </section>

  <div class="quick-title">CMS workspace</div>
  <div class="grid">
    <a class="card" href="/admin/editor/"><div class="icon">✎</div><h2>Publishing Studio</h2><p>Visual + Markdown editing, scheduling, templates, autosave, revisions, SEO and social metadata.</p></a>
    <a class="card" href="/admin/content/"><div class="icon">Aa</div><h2>Posts</h2><p>Browse published, scheduled and private draft content and manage redirects.</p></a>
    <a class="card editor-only" href="/admin/pages/"><div class="icon">Pg</div><h2>Pages & SEO</h2><p>Edit trust, legal and information pages with page-level SEO controls.</p></a>
    <a class="card admin-only" href="/admin/settings/"><div class="icon">St</div><h2>Appearance & settings</h2><p>Brand, navigation, analytics, token health, Search Console and AdSense settings.</p></a>
    <a class="card" href="/admin/media/"><div class="icon">Im</div><h2>Media library</h2><p>Upload optimized images, browse existing media and copy public URLs.</p></a>
    <a class="card editor-only" href="/admin/tools/"><div class="icon">↕</div><h2>Tools & backups</h2><p>JSON backups, WordPress XML export, safe restore checks, templates and health.</p></a>
    <a class="card editor-only" href="/admin/content/#redirects"><div class="icon">301</div><h2>Redirects</h2><p>Maintain SEO redirects that are generated during each successful build.</p></a>
    <a class="card" href="/articles/" target="_blank"><div class="icon">↗</div><h2>Public archive</h2><p>Review the reader-facing article archive and published content.</p></a>
  </div>
  <div class="note">Traffic shown here is first-party CMS page-view data stored in D1. It is intentionally lightweight and does not pretend to be Search Console or full analytics. Public pages remain static-first and published edits remain recoverable through Git history.</div>
</main>
<script is:inline>
  const app = document.querySelector('#app');
  const label = document.querySelector('#sessionLabel');
  const fmt = (n) => new Intl.NumberFormat().format(Number(n || 0));
  const esc = (v) => String(v || '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  async function api(url){const r=await fetch(url,{credentials:'same-origin',cache:'no-store'});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d}
  function renderTraffic(daily){const root=document.querySelector('#trafficChart');if(!(root instanceof HTMLElement))return;if(!daily?.length){root.innerHTML='<div class="empty">No page views recorded yet.</div>';return}const byDay=new Map(daily.map(i=>[i.day,Number(i.views||0)])),days=[];for(let i=29;i>=0;i--){const date=new Date(Date.now()-i*86400000).toISOString().slice(0,10);days.push({day:date,views:byDay.get(date)||0})}const max=Math.max(1,...days.map(i=>i.views));root.innerHTML=days.map(i=>`<div class="bar" title="${i.day}: ${fmt(i.views)} views" style="height:${Math.max(3,Math.round(i.views/max*100))}%"></div>`).join('')}
  function renderTop(items,posts){const root=document.querySelector('#topPosts');if(!(root instanceof HTMLElement))return;const map=new Map((posts||[]).map(p=>[p.slug,p.title]));root.innerHTML=items?.length?items.map(i=>`<div class="row"><div><strong>${esc(map.get(i.slug)||i.slug)}</strong><small>/${esc(i.slug)}/</small></div><div class="number">${fmt(i.views)}</div></div>`).join(''):'<div class="empty">No traffic yet.</div>'}
  function renderSchedule(items,posts){const root=document.querySelector('#scheduleList');if(!(root instanceof HTMLElement))return;const map=new Map((posts||[]).map(p=>[p.slug,p.title]));root.innerHTML=items?.length?items.map(i=>`<div class="row"><div><strong>${esc(map.get(i.slug)||i.slug)}</strong><small>${new Date(i.publishAt).toLocaleString()}</small></div><a class="session" href="/admin/editor/?slug=${encodeURIComponent(i.slug)}">Edit →</a></div>`).join(''):'<div class="empty">No scheduled posts.</div>'}
  Promise.all([api('/api/admin/login'),api('/api/admin/posts'),api('/api/admin/analytics')]).then(([auth,postData,analytics])=>{
    const role=auth.user?.role||'member'; if(label instanceof HTMLElement)label.textContent=`${auth.user?.displayName||auth.user?.username||'CMS user'} · ${role}`;
    if(!['owner','admin'].includes(role))document.querySelectorAll('.admin-only').forEach(node=>node.remove());if(!['owner','admin','editor'].includes(role))document.querySelectorAll('.editor-only').forEach(node=>node.remove());
    const posts=postData.posts||[],now=Date.now();const published=posts.filter(p=>!p.draft&&Date.parse(p.publishAt||`${p.pubDate}T00:00:00Z`)<=now).length;const scheduled=posts.filter(p=>!p.draft&&Date.parse(p.publishAt||`${p.pubDate}T00:00:00Z`)>now).length;
    document.querySelector('#publishedCount').textContent=fmt(published);document.querySelector('#scheduledCount').textContent=fmt(scheduled);document.querySelector('#views30').textContent=fmt(analytics.views?.last30Days);document.querySelector('#viewsToday').textContent=fmt(analytics.views?.today);document.querySelector('#views7').textContent=`${fmt(analytics.views?.last7Days)} views in 7 days`;
    renderTraffic(analytics.daily);renderTop(analytics.topPosts,posts);renderSchedule(analytics.scheduled,posts);if(app instanceof HTMLElement)app.hidden=false;
  }).catch(()=>location.replace('/admin/login/'));
  document.querySelector('#logout')?.addEventListener('click',async()=>{await fetch('/api/admin/login',{method:'DELETE',credentials:'same-origin'}).catch(()=>{});location.replace('/admin/login/')});
</script>
</body>
</html>

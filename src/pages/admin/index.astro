---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>CMS Admin</title>
  <style>
    :root{--bg:#f5f7fa;--panel:#fff;--text:#111827;--muted:#697386;--line:#e2e7ee;--accent:#1769e0;--danger:#b42318}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}button,input,textarea,select{font:inherit}button{cursor:pointer}.shell{display:grid;grid-template-columns:235px minmax(0,1fr);min-height:100vh}.sidebar{background:#101828;color:#d0d5dd;padding:25px 18px;position:sticky;top:0;height:100vh}.logo{font-size:1.25rem;font-weight:850;color:#fff;margin:0 10px 28px}.nav button{width:100%;text-align:left;border:0;background:transparent;color:#aeb7c6;padding:10px 12px;border-radius:8px;margin:2px 0}.nav button.active,.nav button:hover{background:#202939;color:#fff}.main{padding:30px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:26px}.topbar h1{margin:0;font-size:1.7rem;letter-spacing:-.03em}.status{font-size:.83rem;color:var(--muted)}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 5px 20px rgba(16,24,40,.035);overflow:hidden}.panel-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.panel-head h2{font-size:1rem;margin:0}.button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 13px;font-weight:700}.button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.button.danger{color:var(--danger)}.post-row{display:grid;grid-template-columns:minmax(0,1fr) 110px 120px 70px;gap:16px;align-items:center;padding:14px 20px;border-bottom:1px solid var(--line)}.post-row:last-child{border:0}.post-title{font-weight:750}.post-sub{font-size:.8rem;color:var(--muted)}.pill{font-size:.75rem;font-weight:750;border:1px solid var(--line);border-radius:99px;padding:4px 8px;width:max-content}.pill.draft{background:#fff7e6;color:#995c00}.editor{display:none}.editor.active,.view.active{display:block}.view{display:none}.form-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.65fr);gap:20px}.stack{display:grid;gap:16px}.field{display:grid;gap:6px}.field label{font-weight:700;font-size:.84rem}.field small{color:var(--muted)}input,textarea,select{width:100%;border:1px solid var(--line);border-radius:9px;padding:10px 11px;background:#fff;color:var(--text)}textarea{resize:vertical}.body-editor{min-height:470px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;line-height:1.6}.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:17px}.card h3{font-size:.92rem;margin:0 0 14px}.actions{display:flex;gap:9px;flex-wrap:wrap}.message{display:none;padding:11px 13px;border-radius:8px;margin-bottom:16px;font-size:.9rem}.message.show{display:block}.message.ok{background:#ecfdf3;color:#027a48}.message.err{background:#fef3f2;color:#b42318}.toolbar{display:flex;gap:5px;margin-bottom:7px;flex-wrap:wrap}.toolbar button{border:1px solid var(--line);background:#fff;border-radius:6px;padding:5px 8px}.settings-form{max-width:760px;padding:20px}.media-preview{margin-top:10px;max-width:100%;max-height:180px;border-radius:8px}.empty{padding:28px;color:var(--muted)}@media(max-width:900px){.shell{grid-template-columns:1fr}.sidebar{position:static;height:auto;padding:14px}.logo{margin:0 8px 10px}.nav{display:flex;overflow-x:auto}.nav button{white-space:nowrap;width:auto}.main{padding:18px}.form-grid{grid-template-columns:1fr}.post-row{grid-template-columns:1fr 85px}.post-row>:nth-child(3),.post-row>:nth-child(4){display:none}}
  </style>
</head>
<body>
<div class="shell">
  <aside class="sidebar"><div class="logo">CMS Admin</div><div class="nav"><button data-view="posts" class="active">Posts</button><button data-view="editor">New article</button><button data-view="settings">Site settings</button><a href="/" style="display:block;color:#aeb7c6;padding:10px 12px;margin-top:14px">View website ↗</a></div></aside>
  <main class="main">
    <div id="message" class="message"></div>
    <section id="posts" class="view active">
      <div class="topbar"><div><h1>Posts</h1><div class="status" id="adminStatus">Connecting to admin API…</div></div><button class="button primary" id="newPost">New article</button></div>
      <div class="panel"><div class="panel-head"><h2>All articles</h2><button class="button" id="refreshPosts">Refresh</button></div><div id="postList"><div class="empty">Loading…</div></div></div>
    </section>

    <section id="editor" class="view">
      <div class="topbar"><div><h1 id="editorTitle">New article</h1><div class="status">Markdown editor · publish creates a Git commit</div></div><button class="button" data-view="posts">← Back</button></div>
      <form id="postForm" class="form-grid">
        <div class="stack">
          <div class="card stack">
            <div class="field"><label>Title</label><input id="title" maxlength="180" required /></div>
            <div class="field"><label>Slug</label><input id="slug" pattern="[a-z0-9-]+" required /><small>Permanent URL. Avoid changing after indexing.</small></div>
            <div class="field"><label>Description</label><textarea id="description" rows="3" maxlength="320" required></textarea></div>
          </div>
          <div class="card">
            <div class="field"><label>Article</label><div class="toolbar"><button type="button" data-md="## ">H2</button><button type="button" data-wrap="**">Bold</button><button type="button" data-wrap="_">Italic</button><button type="button" data-md="- ">List</button><button type="button" data-link>Link</button></div><textarea id="body" class="body-editor" required placeholder="Write in Markdown…"></textarea></div>
          </div>
        </div>
        <aside class="stack">
          <div class="card stack">
            <h3>Publishing</h3>
            <div class="field"><label>Category</label><input id="category" value="Guides" /></div>
            <div class="field"><label>Tags</label><input id="tags" placeholder="seo, guides, news" /></div>
            <div class="field"><label>Author</label><input id="author" value="Editorial Team" /></div>
            <div class="field"><label>Publish date</label><input id="pubDate" type="date" /></div>
            <label style="display:flex;gap:8px;align-items:center"><input id="noindex" type="checkbox" style="width:auto" /> Noindex this article</label>
            <div class="actions"><button type="button" class="button" id="saveDraft">Save draft</button><button type="button" class="button primary" id="publish">Publish</button><button type="button" class="button danger" id="deletePost" hidden>Delete</button></div>
          </div>
          <div class="card stack">
            <h3>Featured image</h3><input id="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/avif" /><button type="button" class="button" id="uploadImage">Optimize & upload</button><input id="featuredImage" placeholder="/uploads/... or https://..." /><div class="field"><label>Image alt text</label><input id="featuredImageAlt" maxlength="180" /></div><img id="mediaPreview" class="media-preview" hidden alt="" />
          </div>
          <div class="card stack">
            <h3>SEO</h3>
            <div class="field"><label>SEO title</label><input id="seoTitle" maxlength="180" /><small id="seoTitleCount">0 characters</small></div>
            <div class="field"><label>Meta description</label><textarea id="seoDescription" rows="3" maxlength="320"></textarea><small id="seoDescCount">0 characters</small></div>
            <div class="field"><label>Canonical URL</label><input id="canonical" type="url" placeholder="Optional" /></div>
          </div>
        </aside>
      </form>
    </section>

    <section id="settings" class="view">
      <div class="topbar"><div><h1>Site settings</h1><div class="status">Changes trigger a new static build.</div></div></div>
      <div class="panel"><form id="settingsForm" class="settings-form stack">
        <div class="field"><label>Site name</label><input id="siteName" required /></div>
        <div class="field"><label>Logo text</label><input id="logoText" required /></div>
        <div class="field"><label>Tagline</label><input id="tagline" required /></div>
        <div class="field"><label>Description</label><textarea id="siteDescription" rows="3" required></textarea></div>
        <div class="field"><label>Production URL</label><input id="siteUrl" type="url" required /></div>
        <div class="field"><label>Contact email</label><input id="siteEmail" type="email" /></div>
        <div class="field"><label>Default author</label><input id="siteAuthor" /></div>
        <div class="field"><label>Primary color</label><input id="primaryColor" type="color" /></div>
        <div class="field"><label>Navigation (one per line: Label | /url/)</label><textarea id="navigation" rows="7"></textarea></div>
        <div><button class="button primary" type="submit">Save settings</button></div>
      </form></div>
    </section>
  </main>
</div>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  let posts = [];
  let current = null;
  let settingsSha = '';

  function message(text, ok = true) {
    const el = $('message'); if (!el) return;
    el.textContent = text; el.className = `message show ${ok ? 'ok' : 'err'}`;
    window.scrollTo({top:0,behavior:'smooth'}); setTimeout(() => el.classList.remove('show'), 5000);
  }
  function showView(name) {
    document.querySelectorAll('.view').forEach((el) => el.classList.toggle('active', el.id === name));
    document.querySelectorAll('[data-view]').forEach((el) => el.classList.toggle('active', el.getAttribute('data-view') === name));
    if (name === 'settings') loadSettings();
  }
  document.addEventListener('click', (e) => { const target = e.target.closest('[data-view]'); if (target) showView(target.getAttribute('data-view')); });

  function slugify(v){return v.toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,90)}
  $('title')?.addEventListener('input', () => { if (!current && $('slug')) $('slug').value = slugify($('title').value); });
  $('seoTitle')?.addEventListener('input',()=> $('seoTitleCount').textContent=`${$('seoTitle').value.length} characters`);
  $('seoDescription')?.addEventListener('input',()=> $('seoDescCount').textContent=`${$('seoDescription').value.length} characters`);

  async function api(url, options={}) {
    const r = await fetch(url, { headers:{'Content-Type':'application/json', ...(options.headers||{})}, ...options });
    const data = await r.json().catch(()=>({}));
    if (!r.ok) throw new Error(data.error || `Request failed (${r.status})`);
    return data;
  }

  async function loadPosts() {
    $('postList').innerHTML='<div class="empty">Loading…</div>';
    try {
      const data = await api('/api/admin/posts'); posts=data.posts||[]; $('adminStatus').textContent=`Authenticated as ${data.admin} · ${posts.length} articles`;
      if (!posts.length) { $('postList').innerHTML='<div class="empty">No articles yet.</div>'; return; }
      $('postList').replaceChildren(...posts.map((post)=>{
        const row=document.createElement('div'); row.className='post-row';
        const info=document.createElement('div'); info.innerHTML=`<div class="post-title"></div><div class="post-sub"></div>`; info.querySelector('.post-title').textContent=post.title; info.querySelector('.post-sub').textContent=`/${post.slug}/ · ${post.category}`;
        const status=document.createElement('span'); status.className=`pill ${post.draft?'draft':''}`; status.textContent=post.draft?'Draft':'Published';
        const date=document.createElement('div'); date.className='post-sub'; date.textContent=post.pubDate;
        const edit=document.createElement('button'); edit.className='button'; edit.textContent='Edit'; edit.addEventListener('click',()=>editPost(post));
        row.append(info,status,date,edit); return row;
      }));
    } catch(e) { $('postList').innerHTML=`<div class="empty">${e.message}</div>`; $('adminStatus').textContent='Admin API is not configured yet.'; }
  }
  function resetForm(){current=null;$('postForm').reset();$('category').value='Guides';$('author').value='Editorial Team';$('pubDate').value=new Date().toISOString().slice(0,10);$('editorTitle').textContent='New article';$('deletePost').hidden=true;$('mediaPreview').hidden=true;}
  function editPost(post){current={...post,originalSlug:post.slug}; $('editorTitle').textContent='Edit article'; ['title','slug','description','category','author','pubDate','featuredImage','featuredImageAlt','seoTitle','seoDescription','canonical','body'].forEach((id)=>{$(id).value=post[id]||''});$('tags').value=(post.tags||[]).join(', ');$('noindex').checked=!!post.noindex;$('deletePost').hidden=false;if(post.featuredImage){$('mediaPreview').src=post.featuredImage;$('mediaPreview').hidden=false}showView('editor')}
  $('newPost')?.addEventListener('click',()=>{resetForm();showView('editor')}); $('refreshPosts')?.addEventListener('click',loadPosts);
  function formData(draft){return {slug:$('slug').value,originalSlug:current?.originalSlug,title:$('title').value,description:$('description').value,category:$('category').value,tags:$('tags').value.split(',').map(v=>v.trim()).filter(Boolean),author:$('author').value,pubDate:$('pubDate').value,featuredImage:$('featuredImage').value,featuredImageAlt:$('featuredImageAlt').value,seoTitle:$('seoTitle').value,seoDescription:$('seoDescription').value,canonical:$('canonical').value,draft,noindex:$('noindex').checked,body:$('body').value,sha:current?.sha}}
  async function save(draft){try{const data=await api('/api/admin/posts',{method:'POST',body:JSON.stringify(formData(draft))});message(draft?'Draft saved. A build may run, but the article remains hidden.':'Published. GitHub will trigger a new deployment.');await loadPosts();const saved=posts.find(p=>p.slug===data.slug);if(saved)editPost(saved)}catch(e){message(e.message,false)}}
  $('saveDraft')?.addEventListener('click',()=>save(true)); $('publish')?.addEventListener('click',()=>save(false));
  $('deletePost')?.addEventListener('click',async()=>{if(!current||!confirm(`Delete “${current.title}”?`))return;try{await api('/api/admin/posts',{method:'DELETE',body:JSON.stringify({slug:current.slug})});message('Article deleted.');resetForm();await loadPosts();showView('posts')}catch(e){message(e.message,false)}});

  document.querySelectorAll('[data-md]').forEach((b)=>b.addEventListener('click',()=>{const t=$('body'),start=t.selectionStart;t.setRangeText(b.dataset.md,start,start,'end');t.focus()}));
  document.querySelectorAll('[data-wrap]').forEach((b)=>b.addEventListener('click',()=>{const t=$('body'),s=t.selectionStart,e=t.selectionEnd,w=b.dataset.wrap;t.setRangeText(`${w}${t.value.slice(s,e)||'text'}${w}`,s,e,'select');t.focus()}));
  document.querySelector('[data-link]')?.addEventListener('click',()=>{const t=$('body'),s=t.selectionStart,e=t.selectionEnd,label=t.value.slice(s,e)||'link text';t.setRangeText(`[${label}](https://)`,s,e,'select');t.focus()});

  async function optimizeImage(file){const bitmap=await createImageBitmap(file);const max=1600,scale=Math.min(1,max/bitmap.width);const canvas=document.createElement('canvas');canvas.width=Math.round(bitmap.width*scale);canvas.height=Math.round(bitmap.height*scale);canvas.getContext('2d').drawImage(bitmap,0,0,canvas.width,canvas.height);return new Promise((resolve,reject)=>canvas.toBlob((blob)=>blob?resolve(blob):reject(new Error('Image optimization failed.')),'image/webp',.82));}
  $('uploadImage')?.addEventListener('click',async()=>{const file=$('imageFile').files?.[0];if(!file){message('Choose an image first.',false);return}try{message('Optimizing image…');const blob=await optimizeImage(file);const data=await new Promise((resolve)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result).split(',')[1]);reader.readAsDataURL(blob)});const result=await api('/api/admin/media',{method:'POST',body:JSON.stringify({name:file.name,type:'image/webp',data})});$('featuredImage').value=result.url;$('mediaPreview').src=result.url;$('mediaPreview').hidden=false;message('Image uploaded and attached.')}catch(e){message(e.message,false)}});

  async function loadSettings(){try{const data=await api('/api/admin/settings');settingsSha=data.sha;const s=data.settings;$('siteName').value=s.name||'';$('logoText').value=s.logoText||'';$('tagline').value=s.tagline||'';$('siteDescription').value=s.description||'';$('siteUrl').value=s.url||'';$('siteEmail').value=s.email||'';$('siteAuthor').value=s.author||'';$('primaryColor').value=s.primaryColor||'#1769e0';$('navigation').value=(s.navigation||[]).map(i=>`${i.label} | ${i.href}`).join('\n')}catch(e){message(e.message,false)}}
  $('settingsForm')?.addEventListener('submit',async(e)=>{e.preventDefault();const navigation=$('navigation').value.split('\n').map(line=>{const [label,...rest]=line.split('|');return{label:(label||'').trim(),href:rest.join('|').trim()}}).filter(i=>i.label&&i.href);const settings={name:$('siteName').value,logoText:$('logoText').value,tagline:$('tagline').value,description:$('siteDescription').value,url:$('siteUrl').value,email:$('siteEmail').value,author:$('siteAuthor').value,primaryColor:$('primaryColor').value,navigation};try{await api('/api/admin/settings',{method:'PUT',body:JSON.stringify({settings,sha:settingsSha})});message('Site settings saved. A new deployment will start.');await loadSettings()}catch(err){message(err.message,false)}});

  resetForm(); loadPosts();
</script>
</body></html>

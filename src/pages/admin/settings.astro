---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Site Settings</title>
  <style>
    *{box-sizing:border-box}body{margin:0;background:#f5f7fa;color:#111827;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.wrap{width:min(calc(100% - 32px),1040px);margin:0 auto;padding:38px 0 70px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.top h1{margin:0;font-size:2rem}.back{color:#1769e0;text-decoration:none;font-weight:700}.panel{background:#fff;border:1px solid #e2e7ee;border-radius:14px;padding:22px;margin-bottom:18px}.panel h2{margin:0 0 8px;font-size:1.08rem}.panel>p{margin:0 0 18px;color:#667085;font-size:.84rem}.field{display:grid;gap:6px;margin-bottom:15px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}label{font-size:.84rem;font-weight:750}input,textarea{font:inherit;width:100%;padding:10px 11px;border:1px solid #d0d5dd;border-radius:8px}textarea{min-height:92px;line-height:1.5}.hint{font-size:.79rem;color:#667085}.actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.button{border:1px solid #d0d5dd;background:#fff;border-radius:8px;padding:10px 14px;font-weight:750;cursor:pointer;text-decoration:none;color:#111827;display:inline-flex;align-items:center}.primary{background:#1769e0;color:#fff;border-color:#1769e0}.msg{margin-bottom:14px;padding:10px 12px;border-radius:8px;display:none}.msg.show{display:block}.ok{background:#ecfdf3;color:#027a48}.err{background:#fef3f2;color:#b42318}.integration{border:1px solid #d0d5dd;border-radius:12px;padding:16px;background:#fafafa}.integration strong{display:block;margin-bottom:4px}.statusline{font-size:.9rem;font-weight:750;margin-top:8px}.statusline.ok{color:#027a48;background:transparent}.statusline.warn{color:#b54708}.statusline.danger{color:#b42318}.trendbox{border:1px solid #e9d7fe;background:#fbf8ff;border-radius:12px;padding:16px}.trendbox strong{display:block;color:#6941c6;margin-bottom:5px}@media(max-width:720px){.grid,.three{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
<main class="wrap">
  <div class="top"><div><div class="hint">Owner / admin</div><h1>Site settings</h1></div><a class="back" href="/admin/">← Control center</a></div>
  <div id="msg" class="msg"></div>
  <form id="form">
    <section class="panel"><h2>Brand & homepage</h2>
      <div class="grid"><div class="field"><label>Site name</label><input id="name" maxlength="80" required></div><div class="field"><label>Logo text</label><input id="logoText" maxlength="80"></div></div>
      <div class="field"><label>Logo image URL</label><input id="logoUrl" placeholder="/media/logo.webp"><div class="hint">Optional. Leave blank to use the letter mark.</div></div>
      <div class="field"><label>Homepage eyebrow</label><input id="homepageEyebrow" maxlength="80"></div>
      <div class="field"><label>Homepage headline</label><input id="tagline" maxlength="180" required></div>
      <div class="field"><label>Site description</label><textarea id="description" maxlength="320" required></textarea></div>
    </section>

    <section class="panel"><h2>Theme</h2>
      <div class="three"><div class="field"><label>Accent color</label><input id="primaryColor" type="color"></div><div class="field"><label>Surface color</label><input id="surfaceColor" type="color"></div><div class="field"><label>Corner radius (0–24)</label><input id="radius" type="number" min="0" max="24"></div></div>
      <div class="field"><label>Maximum content width (1040–1440 px)</label><input id="maxWidth" type="number" min="1040" max="1440"></div>
    </section>

    <section class="panel"><h2>Navigation & footer</h2>
      <div class="field"><label>Navigation</label><textarea id="navigation" placeholder="Home|/&#10;Guides|/category/guides/"></textarea><div class="hint">One item per line: Label|URL. Relative paths and http/https URLs only.</div></div>
      <div class="field"><label>Footer text</label><textarea id="footerText" maxlength="240"></textarea></div>
      <div class="grid"><div class="field"><label>Contact email</label><input id="email" type="email"></div><div class="field"><label>Default author</label><input id="author" maxlength="100"></div></div>
    </section>

    <section class="panel"><h2>SEO & integrations</h2>
      <div class="grid"><div class="field"><label>Production URL</label><input id="url" type="url" required></div><div class="field"><label>Language</label><input id="language" maxlength="12" placeholder="en"></div></div>
      <div class="field"><label>Default social image</label><input id="defaultOgImage" placeholder="/media/og.webp"></div>
      <div class="grid"><div class="field"><label>Google Analytics ID</label><input id="googleAnalyticsId" placeholder="G-XXXXXXXX"></div><div class="field"><label>Search Console verification</label><input id="googleSiteVerification"></div></div>
      <div class="grid"><div class="field"><label>AdSense publisher</label><input id="adsensePublisherId" placeholder="ca-pub-..."></div><div class="field"><label>Article ad slot</label><input id="adsenseArticleSlot"></div></div>
      <div class="field"><label>Sidebar ad slot</label><input id="adsenseSidebarSlot"></div>
    </section>

    <section class="panel"><h2>Trend intelligence</h2><p>Controls the Google Trends feed and niche matching shown on your dashboard. Zero-cost mode does not use paid AI inference.</p>
      <div class="trendbox">
        <strong>Content niche</strong>
        <div class="field"><label>Describe the site niche</label><textarea id="contentNiche" maxlength="320" placeholder="Jobs, careers, government jobs, recruitment, exams..."></textarea><div class="hint">Be specific. The CMS uses this to reject unrelated trending topics.</div></div>
        <div class="grid"><div class="field"><label>Google Trends country code</label><input id="trendGeo" maxlength="2" placeholder="IN"><div class="hint">Examples: IN, US, GB, CA.</div></div><div class="field"><label>Niche keywords</label><input id="trendKeywords" placeholder="jobs, recruitment, exam, result"><div class="hint">Comma-separated. Up to 40 terms.</div></div></div>
      </div>
    </section>

    <section class="panel"><h2>Social profiles</h2>
      <div class="grid"><div class="field"><label>X / Twitter</label><input id="socialX" type="url"></div><div class="field"><label>LinkedIn</label><input id="socialLinkedin" type="url"></div><div class="field"><label>Instagram</label><input id="socialInstagram" type="url"></div><div class="field"><label>YouTube</label><input id="socialYoutube" type="url"></div></div>
    </section>

    <div class="actions"><button class="button primary" type="submit">Save settings</button><span class="hint">Settings are saved directly to Cloudflare D1.</span></div>
  </form>
</main>
<script is:inline>
  const $ = (id) => document.getElementById(id);
  let settings = {}, sha = '';
  function msg(text, ok = true) { const el = $('msg'); el.textContent = text; el.className = `msg show ${ok ? 'ok' : 'err'}`; setTimeout(() => el.classList.remove('show'), 5000); }
  async function api(url, opt = {}) { const r = await fetch(url, { credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, ...opt }); const d = await r.json().catch(() => ({})); if (!r.ok) throw new Error(d.error || 'Request failed'); return d; }
  function fill() {
    const t = settings.theme || {}, s = settings.social || {};
    $('name').value = settings.name || ''; $('logoText').value = settings.logoText || ''; $('logoUrl').value = settings.logoUrl || ''; $('homepageEyebrow').value = settings.homepageEyebrow || ''; $('tagline').value = settings.tagline || ''; $('description').value = settings.description || '';
    $('primaryColor').value = settings.primaryColor || '#1769e0'; $('surfaceColor').value = t.surfaceColor || '#f6f6f3'; $('radius').value = t.radius ?? 14; $('maxWidth').value = t.maxWidth ?? 1240;
    $('navigation').value = (settings.navigation || []).map((i) => `${i.label}|${i.href}`).join('\n'); $('footerText').value = settings.footerText || ''; $('email').value = settings.email || ''; $('author').value = settings.author || '';
    $('url').value = settings.url || ''; $('language').value = settings.language || 'en'; $('defaultOgImage').value = settings.defaultOgImage || ''; $('googleAnalyticsId').value = settings.googleAnalyticsId || ''; $('googleSiteVerification').value = settings.googleSiteVerification || ''; $('adsensePublisherId').value = settings.adsensePublisherId || ''; $('adsenseArticleSlot').value = settings.adsenseArticleSlot || ''; $('adsenseSidebarSlot').value = settings.adsenseSidebarSlot || '';
    $('contentNiche').value = settings.contentNiche || ''; $('trendGeo').value = settings.trendGeo || 'IN'; $('trendKeywords').value = Array.isArray(settings.trendKeywords) ? settings.trendKeywords.join(', ') : '';
    $('socialX').value = s.x || ''; $('socialLinkedin').value = s.linkedin || ''; $('socialInstagram').value = s.instagram || ''; $('socialYoutube').value = s.youtube || '';
  }
  function capture() {
    settings = { ...settings,
      name: $('name').value, logoText: $('logoText').value, logoUrl: $('logoUrl').value, homepageEyebrow: $('homepageEyebrow').value, tagline: $('tagline').value, description: $('description').value, primaryColor: $('primaryColor').value,
      theme: { surfaceColor: $('surfaceColor').value, radius: Number($('radius').value), maxWidth: Number($('maxWidth').value) },
      navigation: $('navigation').value.split('\n').map((line) => line.trim()).filter(Boolean).map((line) => { const i = line.indexOf('|'); return i > 0 ? { label: line.slice(0, i).trim(), href: line.slice(i + 1).trim() } : { label: line, href: '/' }; }),
      footerText: $('footerText').value, email: $('email').value, author: $('author').value, url: $('url').value, language: $('language').value, defaultOgImage: $('defaultOgImage').value,
      googleAnalyticsId: $('googleAnalyticsId').value, googleSiteVerification: $('googleSiteVerification').value, adsensePublisherId: $('adsensePublisherId').value, adsenseArticleSlot: $('adsenseArticleSlot').value, adsenseSidebarSlot: $('adsenseSidebarSlot').value,
      contentNiche: $('contentNiche').value, trendGeo: $('trendGeo').value, trendKeywords: $('trendKeywords').value.split(',').map((x) => x.trim()).filter(Boolean),
      social: { x: $('socialX').value, linkedin: $('socialLinkedin').value, instagram: $('socialInstagram').value, youtube: $('socialYoutube').value }
    };
  }
  $('form').addEventListener('submit', async (event) => { event.preventDefault(); capture(); try { await api('/api/admin/settings', { method: 'PUT', body: JSON.stringify({ settings, sha }) }); msg('Settings saved to D1.'); const d = await api('/api/admin/settings'); settings = d.settings; sha = d.sha; fill(); } catch (error) { msg(error instanceof Error ? error.message : 'Unable to save settings.', false); } });
  api('/api/admin/settings').then((d) => { settings = d.settings; sha = d.sha; fill(); }).catch((error) => msg(error instanceof Error ? error.message : 'Unable to load settings.', false));
</script>
</body>
</html>

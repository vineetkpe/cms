---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/site-settings';
import '../styles/global.css';
import '../styles/editorial.css';

const site = Astro.props.siteSettings || await getSiteSettings();

const {
  title = site.name,
  description = site.description,
  canonical,
  image,
  socialTitle,
  socialDescription,
  socialImage,
  noindex = false,
  nofollow = false,
  schema,
  ogType = 'website',
  author,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  imageAlt,
  schemaType = 'WebPage'
} = Astro.props;

const cleanText = (value) => String(value || '').replace(/\s+/g, ' ').trim();
const isHome = Astro.url.pathname === '/';
const baseTitle = cleanText(isHome && site.homepageSeoTitle ? site.homepageSeoTitle : title || site.name);
const template = cleanText(site.titleTemplate || '%title% | %site%');
const pageTitle = isHome
  ? baseTitle || site.name
  : (baseTitle.toLowerCase().includes(String(site.name || '').toLowerCase())
      ? baseTitle
      : template.replace(/%title%/g, baseTitle).replace(/%site%/g, site.name));
const metaDescription = cleanText(description || site.defaultMetaDescription || site.description).slice(0, 320);
const canonicalUrl = canonical || new URL(Astro.url.pathname, site.url).toString();
const selectedImage = socialImage || image || site.defaultOgImage || '';
const ogImage = selectedImage ? new URL(selectedImage, site.url).toString() : undefined;
const ogTitle = cleanText(socialTitle || pageTitle);
const ogDescription = cleanText(socialDescription || metaDescription);
const ogImageAlt = cleanText(imageAlt || site.defaultOgImageAlt || title || site.name);
const socialUrls = Object.values(site.social || {}).filter(Boolean);
const logo = site.logoUrl ? new URL(site.logoUrl, site.url).toString() : undefined;
const locale = String(site.language || 'en').replace('-', '_');
const theme = site.theme || { surfaceColor: '#f6f6f3', radius: 14, maxWidth: 1240 };
const robots = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow', 'max-image-preview:large', 'max-snippet:-1', 'max-video-preview:-1'].join(',');

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  alternateName: site.shortName || undefined,
  url: site.url,
  description: site.defaultMetaDescription || site.description,
  inLanguage: site.language || 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: site.shortName || undefined,
  description: site.defaultMetaDescription || site.description,
  url: site.url,
  email: site.email || undefined,
  logo,
  sameAs: socialUrls.length ? socialUrls : undefined
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': canonicalUrl,
  url: canonicalUrl,
  name: pageTitle,
  description: metaDescription,
  isPartOf: { '@type': 'WebSite', '@id': `${site.url}/#website` },
  primaryImageOfPage: ogImage ? { '@type': 'ImageObject', url: ogImage, caption: ogImageAlt } : undefined,
  inLanguage: site.language || 'en'
};

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = [websiteSchema, organizationSchema, webPageSchema, ...extraSchemas];
const jsonLd = JSON.stringify(schemas)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---
<!doctype html>
<html lang={site.language || 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={site.name} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {author && <meta name="author" content={author} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && section && <meta property="article:section" content={section} />}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    {ogType === 'article' && Array.isArray(tags) && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {site.twitterHandle && <meta name="twitter:site" content={site.twitterHandle} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}

    {site.faviconUrl && <link rel="icon" href={site.faviconUrl} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <meta name="theme-color" content={site.primaryColor} />
    <style is:inline>{`:root{--accent:${site.primaryColor};--surface:${theme.surfaceColor};--radius:${theme.radius}px;--max:${theme.maxWidth}px}`}</style>
    <script type="application/ld+json" set:html={jsonLd}></script>

    {site.googleAnalyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${site.googleAnalyticsId}',{anonymize_ip:true});`}></script>
      </>
    )}
    {site.adsensePublisherId && <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsensePublisherId}`}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header site={site} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer site={site} />
  </body>
</html>
